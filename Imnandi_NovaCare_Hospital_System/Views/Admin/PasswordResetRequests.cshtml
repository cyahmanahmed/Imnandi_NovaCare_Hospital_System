@model List<PeopleForgotPassword>

@{
    ViewData["Title"] = "Password Reset Requests";
    var searchString = ViewBag.SearchString as string;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-key-fill me-2"></i>
                Password Reset Requests
            </h2>

            <p class="text-muted mb-0">
                View and manage employee password reset requests.
            </p>
        </div>

        <a asp-action="ManageEmployees"
           class="btn btn-outline-primary rounded-pill px-4">

            <i class="bi bi-arrow-left-circle me-2"></i>

            Back to Employees

        </a>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <form asp-action="PasswordResetRequests" method="get">

                <div class="row">

                    <div class="col-md-5">

                        <div class="input-group">

                            <input type="text"
                                   name="searchString"
                                   value="@searchString"
                                   class="form-control"
                                   placeholder="Search by employee name..." />

                            <button class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>

                                Search

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card border-0 shadow rounded-4">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between">

                <h5 class="mb-0">

                    <i class="bi bi-person-lock me-2"></i>

                    Password Reset Requests

                </h5>

                <span>

                    @Model.Count Request(s)

                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>#</th>

                        <th>Full Name</th>

                        <th>Email</th>

                        <th>Requested</th>

                        <th>Status</th>

                        <th class="text-center">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        int count = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@count</td>

                                <td class="fw-semibold">
                                    @item.FullName
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @item.RequestedAt.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>

                                    @if (item.IsHandled)
                                    {
                                        <span class="badge bg-success">
                                            Handled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    @if (!item.IsHandled)
                                    {
                                        <a asp-action="ResetUserPassword"
                                           asp-route-id="@item.UserId"
                                           class="btn btn-sm btn-warning">

                                            <i class="bi bi-key-fill me-1"></i>

                                            Reset Password

                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" disabled>

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Completed

                                        </button>
                                    }

                                </td>

                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6" class="text-center py-5">

                                <i class="bi bi-check-circle display-5 text-success"></i>

                                <h5 class="mt-3">
                                    No password reset requests found.
                                </h5>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>