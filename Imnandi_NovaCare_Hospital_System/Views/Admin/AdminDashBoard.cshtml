@using Imnandi_NovaCare_Hospital_System.Models
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            overflow: auto;
        }

        .admin-sidebar {
            background-color: #2c3e50;
            width: 250px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 1rem;
            color: white;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .admin-sidebar a {
            display: block;
            padding: 0.9rem 1.25rem;
            color: white;
            text-decoration: none;
            font-size: 0.95rem;
        }

        .admin-sidebar a:hover {
            background-color: #34495e;
        }

        .admin-sidebar .section-title {
            padding: 0.75rem 1.25rem;
            text-transform: uppercase;
            font-size: 0.8rem;
            color: #adb5bd;
        }

        .admin-dashboard-content {
            margin-left: 250px;
            padding: 2rem;
            min-height: 100vh;
        }

        .card {
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

        .stats-card {
            transition: transform 0.2s ease-in-out;
        }

        .stats-card:hover {
            transform: translateY(-4px);
        }

        .stats-card h2 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .stats-card p {
            margin: 0;
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .btn-view {
            background-color: #0d6efd;
            color: white;
            border-radius: 6px;
            padding: 4px 12px;
        }

            .btn-view:hover {
                background-color: #0a58ca;
            }

        .table th {
            background-color: #e9ecef;
        }

        .fw-bold {
            font-weight: 600 !important;
        }
    </style>
</head>

<body>
    <div class="admin-sidebar">
        <h3 class="text-center mb-4 fw-bold">Admin Panel</h3>
        <a asp-controller="Admin" asp-action="ManageEmployees"><i class="bi bi-people-fill me-2"></i> Manage Employees</a>
        <a asp-controller="Admin" asp-action="ManageAllergies"><i class="bi bi-heart-pulse-fill me-2"></i> Manage Allergies</a>
        <a asp-controller="Admin" asp-action="ManageMedication"><i class="bi bi-capsule me-2"></i> Manage Medication</a>
        <a asp-controller="Admin" asp-action="ManageWard"><i class="bi bi-building-add me-2"></i> Manage Wards</a>
        <a asp-controller="Admin" asp-action="ManageRooms"><i class="bi bi-door-open-fill me-2"></i> Manage Rooms</a>
        <a asp-controller="Admin" asp-action="ManageBeds"><i class="bi bi-hdd-stack-fill me-2"></i> Manage Beds</a>
        <a asp-controller="Admin" asp-action="ManageAlerts"><i class="bi bi-bell-fill me-2"></i> Create Alert</a>
        <a asp-controller="Admin" asp-action="ManageAuditLogs"><i class="bi bi-journal-text me-2"></i> Manage AuditLogs</a>
        <a asp-controller="Admin" asp-action="ManageHospitalPharmacy"><i class="bi bi-shop-window me-2"></i> Manage Pharmacy</a>
        <a asp-controller="Admin" asp-action="ManageHospitalStore"><i class="bi bi-box-seam me-2"></i> Manage Store</a>

        <h6 class="section-title">Settings</h6>
        <a  asp-controller="Admin" asp-action="Profile"><i class="bi bi-gear me-2"></i> Profile</a>
        <a href="/Identity/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i> Log Out</a>
    </div>

    <div class="admin-dashboard-content">
        <h1 class="mb-4 fw-bold">Welcome, @Model.FirstName @Model.LastName</h1>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: #0d6efd;">
                    <h2>@Model.TotalPatients</h2>
                    <p>Total Patients</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: green;">
                    <h2>@Model.TotalDoctors</h2>
                    <p>Total Doctors</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: hotpink;">
                    <h2>@Model.TotalNurses</h2>
                    <p>Total Nurses</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: red;">
                    <h2>@Model.TotalNurseSisters</h2>
                    <p>Total Nurse Sisters</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: orange;">
                    <h2>@Model.TotalWardAdmins</h2>
                    <p>Total Ward Admins</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: brown;">
                    <h2>@Model.TotalScriptManagers</h2>
                    <p>Total Script Managers</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: #0dcaf0;">
                    <h2>@Model.TotalStockManagers</h2>
                    <p>Total Stock Managers</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center text-white stats-card" style="background-color: purple;">
                    <h2>@Model.TotalWards</h2>
                    <p>Hospital Wards</p>
                </div>
            </div>
        </div>

        <div class="card p-4 mb-4">

            <div class="d-flex align-items-center mb-3">
                <div class="me-3">
                    <i class="bi bi-person-badge fs-2 text-primary"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">
                    </h5>

                    <span class="text-muted">
                        @Model.Department Department
                    </span>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4">
                    <strong>Name</strong>
                    <p class="text-muted mb-0">
                        @Model.FirstName @Model.LastName
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Job Title</strong>
                    <p class="text-muted mb-0">
                        @Model.JobTitle
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Email</strong>
                    <p class="text-muted mb-0">
                        @Model.Email
                    </p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Recent Patient Admissions</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Patient Name</th>
                                <th>Admission Date</th>
                                <th>Ward</th>
                                <th>Room</th>
                                <th>Bed</th>
                                <th>Reason</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentAdmissions != null && Model.RecentAdmissions.Any())
                            {
                                @foreach (dynamic admission in Model.RecentAdmissions)
                                {
                                    <tr>
                                        <td>@admission.FullName</td>
                                        <td>@admission.DateAdmitted?.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@admission.WardName</td>
                                        <td>@admission.RoomNumber</td>
                                        <td>@admission.BedNumber</td>
                                        <td>@admission.ReasonForAdmission</td>
                                        <td>
                                            <a href="#" class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center">No recent admissions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
