@using Imnandi_NovaCare_Hospital_System.Models
@model IEnumerable<Medication>

@{
    ViewData["Title"] = "Manage Medication";
    var search = ViewData["Search"]?.ToString() ?? "";
}

<div class="container-fluid py-5">

    <div class="col-12 mb-3">
        <a asp-controller="Admin" asp-action="AdminDashboard"
           class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
           style="border-radius: 80px;">
            <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
        </a>
    </div>

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-primary">
                <i class="bi bi-capsule me-2"></i> Medication Management
            </h1>
            <p class="text-muted mb-0">View all medications in the system, including details and usage reference.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-10 col-lg-8">
            <form method="get" class="input-group input-group-lg shadow-sm rounded">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-0"
                       placeholder="Search by name, manufacturer..." value="@search" />
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="ManageMedication" class="btn btn-outline-secondary">Clear</a>
                }
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-capsule text-muted" style="font-size: 4rem;"></i>
                    <h4 class="text-muted mt-3">No medications found</h4>
                    <p class="text-secondary">Adjust your search or filters to see results.</p>
                </div>
            }
            else
            {
                <table class="table table-bordered table-striped shadow-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Dosage Form</th>
                            <th>Manufacturer</th>
                            <th>Prescriptions Count</th>
                            <th>Administration Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var med in Model)
                        {
                            <tr>
                                <td>@med.MedicationName</td>
                                <td>@med.Description</td>
                                <td>@med.DosageForm</td>
                                <td>@med.Manufacturer</td>
                                <td>@med.Prescription.Count()</td>
                                <td>@med.MedicationAdministration.Count()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
   
    <a asp-controller="Reports" asp-action="MedicationReport"
       class="btn btn-lg btn-info shadow-sm d-flex align-items-center justify-content-center ms-2">
        <i class="bi bi-file-earmark-pdf-fill me-2"></i> Generate Report
    </a>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    body {
        background: linear-gradient(135deg, #f9fbfd 0%, #f0f4f8 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .display-6 {
        font-size: 2rem;
        font-weight: 700;
    }

    .table thead th {
        vertical-align: middle;
        text-align: center;
    }

    .table tbody td {
        vertical-align: middle;
    }

    .btn-outline-primary {
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 500;
    }
</style>
