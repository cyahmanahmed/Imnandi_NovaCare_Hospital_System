@model IEnumerable<AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
    var searchUsername = Context.Request.Query["searchUsername"].ToString();
    var selectedRole = Context.Request.Query["role"].ToString();
    var isDeletedParam = Context.Request.Query["isDeleted"].ToString();
    bool? isDeletedFilter = string.IsNullOrEmpty(isDeletedParam) ? null : (bool?)bool.Parse(isDeletedParam);
}

<style>
    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', system-ui, sans-serif;
        color: #1e293b;
    }

    .header-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.25rem;
    }

    .sub-title {
        color: #64748b;
        margin-bottom: 1.5rem;
    }

    .filters-section {
        background: white;
        padding: 1.25rem;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        margin-bottom: 1.5rem;
    }

    .filter-row {
        gap: 1rem;
    }

    .filter-group {
        flex: 1;
        min-width: 200px;
    }

        .filter-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 0.375rem;
            color: #475569;
        }

        .filter-group input,
        .filter-group select {
            width: 100%;
            padding: 0.625rem 0.875rem;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 0.95rem;
            background: white;
        }

    .btn-filter {
        height: fit-content;
        padding: 0.625rem 1.25rem;
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-filter:hover {
            background: #2563eb;
        }

    .btn-reset {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        margin-left: 0.75rem;
    }

        .btn-reset:hover {
            background: #e2e8f0;
        }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .card-header {
        padding: 1.125rem 1.5rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-header h5 {
            margin: 0;
            font-weight: 600;
            color: #0f172a;
        }

    .table-container {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        padding: 1rem 1.25rem;
        text-align: left;
        font-weight: 600;
        color: #475569;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
    }

    tbody tr {
        background-color: #ffffff !important;
    }

        tbody tr:hover {
            background-color: #f8fafc !important;
        }

    tbody td {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.95rem;
        color: #1e293b;
    }

    .badge-role {
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .role-admin {
        background: #dbeafe;
        color: #2563eb;
    }

    .role-doctor {
        background: #ffedd5;
        color: #c2410c;
    }

    .role-wardAdmin {
        background: #ffedd5;
        color: #c2410c;
    }

    .role-nurse {
        background: #dcfce7;
        color: #16a34a;
    }

    .role-scriptmanager,
    .role-stockmanager {
        background: #ede9fe;
        color: #7c3aed;
    }

    .status-active {
        color: #16a34a;
        font-weight: 600;
    }

    .status-deleted {
        color: #ef4444;
        font-weight: 600;
    }

    .view-user-logs {
        color: #3b82f6;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .view-user-logs:hover {
            text-decoration: underline;
        }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #64748b;
    }

        .empty-state i {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: #cbd5e1;
        }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <a asp-controller="Admin" asp-action="AdminDashBoard"
               class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
               style="border-radius: 80px;">
                <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="header-title">Audit Logs</h1>
            <p class="sub-title">Track system activity by user, role, and status.</p>
        </div>
    </div>

    <div class="filters-section">
        <form method="get">
            <div class="row filter-row align-items-end">
                <div class="col-md-4 col-lg-3 filter-group">
                    <label for="searchUsername">Username</label>
                    <input type="text"
                           id="searchUsername"
                           name="searchUsername"
                           value="@searchUsername"
                           placeholder="Search username" />
                </div>
                <div class="col-md-3 col-lg-2 filter-group">
                    <label for="role">Role</label>
                    <select name="role" id="role">
                        <option value="">All Roles</option>
                        <option value="Admin" selected="@(selectedRole == "Admin")">Admin</option>
                        <option value="Doctor" selected="@(selectedRole == "Doctor")">Doctor</option>
                        <option value="Nurse" selected="@(selectedRole == "Nurse")">Nurse</option>
                        <option value="WardAdmin" selected="@(selectedRole == "WardAdmin")">Ward Admin</option>
                        <option value="ScriptManager" selected="@(selectedRole == "ScriptManager")">Script Manager</option>
                        <option value="StockManager" selected="@(selectedRole == "StockManager")">Stock Manager</option>
                    </select>
                </div>
                <div class="col-md-3 col-lg-2 filter-group">
                    <label for="isDeleted">User Status</label>
                    <select name="isDeleted" id="isDeleted">
                        <option value="">All</option>
                        <option value="false" selected="@(isDeletedFilter == false)">Active</option>
                        <option value="true" selected="@(isDeletedFilter == true)">Deleted</option>
                    </select>
                </div>
                <div class="col-md-2 col-lg-2 d-flex">
                    <button type="submit" class="btn-filter">Apply Filters</button>
                    <a asp-action="ManageAuditLogs" class="btn-filter btn-reset">Reset</a>
                </div>
            </div>
        </form>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Audit Log Entries</h5>
                    <small>@Model.Count() logs</small>
                </div>
                <div class="table-container">
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-clipboard-list"></i>
                            <h5>No audit logs found</h5>
                            <p>Try adjusting your filters.</p>
                        </div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Timestamp</th>
                                    <th>Username</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                    <th>User Logs</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model)
                                {
                                    <tr>
                                        <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>
                                            <strong>@log.Username</strong>
                                            @if (log.User != null && log.User.UserName != log.Username)
                                            {
                                                <br />
                                    
                                                <small class="text-muted">(@log.User.UserName)</small>
                                            }
                                        </td>
                                        <td>
                                            @if (log.User != null)
                                            {
                                                <span class="badge-role role-@(log.User.Role?.ToLower().Replace(" ", "") ?? "user")">
                                                    @log.User.Role
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (log.User != null)
                                            {
                                                if (log.User.IsDeleted)
                                                {
                                                    <span class="status-deleted">Deleted</span>
                                                }
                                                else
                                                {
                                                    <span class="status-active">Active</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>@log.ActionTaken</td>
                                        <td>
                                            <pre style="margin: 0; white-space: pre-wrap; word-break: break-word; font-family: monospace; font-size: 0.85rem; color: #475569;">@log.Details</pre>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(log.UserId))
                                            {
                                                <a asp-action="AuditLogDetails"
                                                   asp-route-userId="@log.UserId"
                                                   class="view-user-logs">
                                                    View Logs
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.js"></script>