@model IEnumerable<Order>

@{
    ViewData["Title"] = "Request Management";
    var search = ViewData["Search"]?.ToString() ?? "";
    var filter = ViewData["Filter"]?.ToString() ?? "All";
    var sortBy = ViewData["SortBy"]?.ToString() ?? "OrderName";
    var ascending = (bool)(ViewData["Ascending"] ?? true);

    var filterOptions = new List<SelectListItem>
    {
        new SelectListItem { Value = "All", Text = "All", Selected = filter=="All" },
        new SelectListItem { Value = "Active", Text = "Active", Selected = filter=="Active" },
        new SelectListItem { Value = "Deleted", Text = "Deleted", Selected = filter=="Deleted" },
        new SelectListItem { Value = "Received", Text = "Received", Selected = filter=="Received" },
        new SelectListItem { Value = "Pending", Text = "Pending", Selected = filter=="Pending" }
    };
}

<div class="container-fluid py-5">
    <div class="col-12 mb-3">
        <a asp-controller="StockManager" asp-action="StockManagerDashboard"
           class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
           style="border-radius: 80px;">
            <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
        </a>
    </div>

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-primary">
                <i class="bi bi-box-seam me-2"></i> Request Management
            </h1>
            <p class="text-muted mb-0">Manage orders and their associated items.</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="CreateOrder" class="btn btn-primary btn-lg shadow-sm" style="border-radius: 50px;">
                <i class="bi bi-plus-circle me-2"></i> Add New Order
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-10 col-lg-8">
            <form method="get" class="input-group input-group-lg shadow-sm rounded">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-0"
                       placeholder="Search by order number, name or description..." value="@search" />

                <select class="form-select" name="filter">
                    @foreach (var opt in filterOptions)
                    {
                        <option value="@opt.Value" selected="@(opt.Selected ? "selected" : null)">@opt.Text</option>
                    }
                </select>

                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="ManageOrders" class="btn btn-outline-secondary">Clear</a>
                }
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex gap-3 flex-wrap align-items-center">
                <span class="fw-bold">Sort by:</span>
                <a asp-action="ManageOrders" asp-route-sortBy="OrderNumber" asp-route-ascending="@(!ascending)" class="btn btn-outline-secondary btn-sm">
                    Order Number
                    @if (sortBy == "OrderNumber")
                    {
                        <i class="bi @(ascending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                    }
                </a>
                <a asp-action="ManageOrders" asp-route-sortBy="OrderName" asp-route-ascending="@(!ascending)" class="btn btn-outline-secondary btn-sm">
                    Order Name
                    @if (sortBy == "OrderName")
                    {
                        <i class="bi @(ascending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                    }
                </a>
                <a asp-action="ManageOrders" asp-route-sortBy="Date" asp-route-ascending="@(!ascending)" class="btn btn-outline-secondary btn-sm">
                    Date
                    @if (sortBy == "Date")
                    {
                        <i class="bi @(ascending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                    }
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-box-seam text-muted" style="font-size: 4rem;"></i>
                <h4 class="text-muted mt-3">No orders found</h4>
                <p class="text-secondary">Adjust your search or filters to see results.</p>
            </div>
        }
        else
        {
            foreach (var order in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 hover-lift" style="border-radius: 16px;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="mb-0 text-dark">
                                    <i class="bi bi-file-earmark-text text-primary me-2"></i>@order.OrderNumber
                                </h5>
                                @if (order.IsReceived)
                                {
                                    <span class="badge bg-success">Received</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </div>

                            <ul class="list-unstyled small mb-3">
                                <li><strong>Order Name:</strong> @order.OrderName</li>
                                <li><strong>Date:</strong> @order.Date.ToString("dd/MM/yyyy")</li>
                                <li><strong>Description:</strong> @order.Description</li>
                            </ul>

                            @if (order.OrderItems != null && order.OrderItems.Any())
                            {
                                <div class="border-top pt-2 mt-2">
                                    <h6 class="fw-semibold text-primary mb-2">Order Items</h6>
                                    <ul class="list-group list-group-flush small">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                                <span>@item.Consumable?.ConsumableName</span>
                                                <span class="text-muted">
                                                    Requested: <strong>@item.QuantityRequested</strong>
                                                    @if (item.QuantityReceived.HasValue)
                                                    {
                                                        <span> | Received: <strong>@item.QuantityReceived</strong></span>
                                                    }
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small"><em>No items added to this order yet.</em></p>
                            }

                            <div class="d-flex justify-content-between mt-4 flex-wrap gap-2">
                                @if (!order.IsDeleted)
                                {
                                    <a asp-action="EditOrder" asp-route-Id="@order.OrderId" class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-pencil-fill me-1"></i> Edit
                                    </a>
                                    <form asp-action="DeleteOrder" asp-route-Id="@order.OrderId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash-fill me-1"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-action="RestoreOrder" asp-route-Id="@order.OrderId" class="btn btn-info btn-sm">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    body {
        background: linear-gradient(135deg, #f9fbfd 0%, #f0f4f8 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .hover-lift {
        transition: all 0.3s ease;
        border: 1px solid #e0e7ff;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border-color: #a5b4fc;
        }

    .btn-outline-primary, .btn-outline-warning, .btn-outline-danger, .btn-outline-success {
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .display-6 {
        font-size: 2rem;
        font-weight: 700;
    }

    .list-group-item {
        border: none;
        background-color: transparent;
        padding: 0.4rem 0;
    }
</style>
