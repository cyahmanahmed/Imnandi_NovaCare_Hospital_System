@model List<MedicineOrder>

@{
    ViewData["Title"] = "Manage Medicine Orders";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-capsule-pill text-primary me-2"></i>
                Manage Medicine Orders
            </h2>

            <p class="text-muted mb-0">
                View and manage medicine orders placed by the supply chain.
            </p>
        </div>

        <a asp-controller="StockManager"
           asp-action="StockManagerDashboard"
           class="btn btn-outline-primary px-3 shadow-sm"
           style="border-radius: 50px;">

            <i class="bi bi-house-door-fill me-2"></i>
            Back to Dashboard

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card border-0 shadow-sm mb-4"
         style="border-radius: 16px;">

        <div class="card-body p-3">

            <div class="row g-3 align-items-center">

                <div class="col-lg-8">

                    <form asp-controller="StockManager"
                          asp-action="ManageMedicineOrders"
                          method="get">

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search text-muted"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@Context.Request.Query["search"]"
                                   class="form-control"
                                   placeholder="Search by order number or order name..." />

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-search me-1"></i>
                                Search

                            </button>

                            @if (!string.IsNullOrWhiteSpace(Context.Request.Query["search"]))
                            {
                                <a asp-controller="StockManager"
                                   asp-action="ManageMedicineOrders"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-x-lg me-1"></i>
                                    Clear

                                </a>
                            }

                        </div>

                    </form>

                </div>

                <div class="col-lg-4 text-lg-end">

                    <a asp-controller="StockManager"
                       asp-action="CreateMedicineOrder"
                       class="btn btn-primary px-4 shadow-sm"
                       style="border-radius: 50px;">

                        <i class="bi bi-plus-circle-fill me-2"></i>
                        Create Medicine Order

                    </a>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm"
         style="border-radius: 16px;">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-clipboard2-pulse text-primary me-2"></i>
                        Medicine Orders
                    </h5>

                    <p class="text-muted small mb-0">
                        Orders placed for medicines and medical treatment stock.
                    </p>

                </div>

                <span class="badge bg-light text-dark border px-3 py-2">
                    @Model.Count order@(Model.Count == 1 ? "" : "s")
                </span>

            </div>

        </div>


        <div class="card-body px-4 pb-4">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width: 120px;">
                                    #
                                </th>

                                <th>
                                    Order
                                </th>

                                <th>
                                    Medicines
                                </th>

                                <th>
                                    Supplier
                                </th>

                                <th>
                                    Hospital Store
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {
                                var totalRequested = order.MedicineOrderItems?
                                .Where(i => !i.IsDeleted)
                                .Sum(i => i.QuantityRequested) ?? 0;

                                var totalReceived = order.MedicineOrderItems?
                                .Where(i => !i.IsDeleted)
                                .Sum(i => i.QuantityReceived) ?? 0;

                                <tr>
                                    <td>

                                        <span class="fw-semibold text-primary">
                                            @order.MedicineOrderId
                                        </span>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @order.OrderName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(order.OrderNumber))
                                        {
                                            <small class="text-muted">
                                                @order.OrderNumber
                                            </small>
                                        }

                                    </td>

                                    <td>

                                        @if (order.MedicineOrderItems != null && order.MedicineOrderItems.Any(i => !i.IsDeleted))
                                        {
                                            <div class="mb-1">

                                                <span class="badge bg-primary-subtle text-primary">
                                                    @order.MedicineOrderItems.Count(i => !i.IsDeleted)
                                                    medicine@(order.MedicineOrderItems.Count(i => !i.IsDeleted) == 1 ? "" : "s")
                                                </span>

                                            </div>

                                            <div class="small text-muted"
                                                 style="max-width: 240px;">

                                                @{
                                                    var medicineNames = order.MedicineOrderItems
                                                    .Where(i => !i.IsDeleted)
                                                    .Select(i => i.Medication?.MedicationName)
                                                    .Where(n => !string.IsNullOrWhiteSpace(n))
                                                    .Take(3)
                                                    .ToList();
                                                }

                                                @string.Join(", ", medicineNames)

                                                @if (order.MedicineOrderItems.Count(i => !i.IsDeleted) > 3)
                                                {
                                                    <span>
                                                        + @(order.MedicineOrderItems.Count(i => !i.IsDeleted) - 3) more
                                                    </span>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No medicines
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (order.Supplier != null)
                                        {
                                            <span>
                                                @order.Supplier.SupplierName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (order.HospitalStore != null)
                                        {
                                            <span>
                                                @order.HospitalStore.HospitalStoreName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <span>
                                            @order.Date.ToString("dd MMM yyyy")
                                        </span>

                                    </td>

                                    <td>

                                        @if (order.IsReceived)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">

                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Received

                                            </span>

                                            <div class="small text-muted mt-1">

                                                @totalReceived.ToString("N0")
                                                /
                                                @totalRequested.ToString("N0")

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2">

                                                <i class="bi bi-clock-fill me-1"></i>
                                                Pending

                                            </span>

                                            <div class="small text-muted mt-1">

                                                @totalRequested.ToString("N0")
                                                requested

                                            </div>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-controller="StockManager"
                                               asp-action="EditMedicineOrder"
                                               asp-route-id="@order.MedicineOrderId"
                                               class="btn btn-outline-primary btn-sm"
                                               style="border-radius: 50px;"
                                               title="Edit medicine order">

                                                <i class="bi bi-pencil-square">Edit</i>

                                            </a>


                                            @if (!order.IsReceived)
                                            {
                                                <form asp-controller="StockManager"
                                                      asp-action="ReceiveMedicineOrder"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="medicineOrderId"
                                                           value="@order.MedicineOrderId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-success btn-sm"
                                                            style="border-radius: 50px;"
                                                            title="Receive medicine order">

                                                        <i class="bi bi-box-arrow-in-down me-1"></i>
                                                        Receive

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <span class="btn btn-outline-secondary btn-sm disabled"
                                                      style="border-radius: 50px;"
                                                      title="Order already received">

                                                    <i class="bi bi-check-lg"></i>

                                                </span>
                                            }


                                            <form asp-controller="StockManager"
                                                  asp-action="DeleteMedicineOrder"
                                                  asp-route-id="@order.MedicineOrderId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this medicine order?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        style="border-radius: 50px;"
                                                        title="Delete medicine order">

                                                    <i class="bi bi-trash">Delete</i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-capsule-pill text-muted"
                           style="font-size: 4rem;">
                        </i>

                    </div>

                    <h5 class="fw-bold">
                        No Medicine Orders Found
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["search"]))
                    {
                        <p class="text-muted mb-3">
                            No medicine orders matched your search.
                        </p>

                        <a asp-controller="StockManager"
                           asp-action="ManageMedicineOrders"
                           class="btn btn-outline-primary px-4"
                           style="border-radius: 50px;">

                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Clear Search

                        </a>
                    }
                    else
                    {
                        <p class="text-muted mb-3">
                            There are currently no medicine orders.
                        </p>

                        <a asp-controller="StockManager"
                           asp-action="CreateMedicineOrder"
                           class="btn btn-primary px-4"
                           style="border-radius: 50px;">

                            <i class="bi bi-plus-circle me-2"></i>
                            Create First Medicine Order

                        </a>
                    }

                </div>
            }

        </div>

    </div>

</div>