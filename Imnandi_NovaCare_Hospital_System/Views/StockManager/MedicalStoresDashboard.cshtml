@using Imnandi_NovaCare_Hospital_System.Models
@model StockManagerDashboardViewModel

@{
    ViewData["Title"] = "Medical Stores Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            overflow-y: visible;
        }

        .sm-sidebar {
            background-color: #2c3e50;
            width: 250px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 1rem;
            color: white;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

            .sm-sidebar a {
                display: block;
                padding: 0.9rem 1.25rem;
                color: white;
                text-decoration: none;
                font-size: 0.95rem;
            }

                .sm-sidebar a:hover {
                    background-color: #34495e;
                }

            .sm-sidebar .section-title {
                padding: 0.75rem 1.25rem;
                text-transform: uppercase;
                font-size: 0.8rem;
                color: #adb5bd;
            }

        .sm-dashboard-content {
            margin-left: 250px;
            padding: 2rem;
        }

        .card {
            border-radius: 10px;
            border: none;
            box-shadow: 0 4px 10px rgba(0, 0, 0, .08);
        }

        .stats-card h2 {
            font-size: 2rem;
            margin: 0;
            font-weight: 700;
        }

        .btn-action {
            background-color: #0d6efd;
            color: white;
            border-radius: 6px;
            padding: 5px 12px;
            text-decoration: none;
            display: inline-block;
        }

            .btn-action:hover {
                background-color: #0a58ca;
                color: white;
            }

        .search-box input {
            height: 45px;
            border-radius: 6px;
        }

        .table th {
            white-space: nowrap;
        }

        .department-badge {
            font-size: .85rem;
            padding: .45rem .7rem;
        }
    </style>
</head>

<body>

    <div class="sm-sidebar">

        <h3 class="text-center mb-4 fw-bold">
            Stock Manager Panel
        </h3>

        <a asp-controller="StockManager"
           asp-action="ManageConsumables"
           class="nav-link">
            <i class="bi bi-boxes me-2"></i>
            Create Consumable
        </a>

        <a asp-controller="StockManager"
           asp-action="ManageStock"
           class="nav-link">
            <i class="bi bi-clipboard-data me-2"></i>
            Perform Stock Audit
        </a>

        <a asp-controller="StockManager"
           asp-action="ManageWardStock"
           class="nav-link">
            <i class="bi bi-boxes me-2"></i>
            Manage Ward Stock
        </a>

        <a asp-controller="StockManager"
           asp-action="ManageWardMedicationStock"
           class="nav-link">
            <i class="bi bi-capsule me-2"></i>
            Manage Ward Medication
        </a>

        <a asp-controller="StockManager"
           asp-action="ViewAlerts">
            <i class="bi bi-bell me-2"></i>
            View Alerts
        </a>

        <h6 class="section-title">
            Settings
        </h6>

        <a asp-controller="StockManager"
           asp-action="Profile">
            <i class="bi bi-gear me-2"></i>
            Profile
        </a>

        <a href="/Identity/Account/Logout">
            <i class="bi bi-box-arrow-right me-2"></i>
            Log Out
        </a>

    </div>

    <div class="sm-dashboard-content">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h1 class="fw-bold mb-1">
                    Welcome, @Model.FirstName @Model.LastName
                </h1>

                <p class="text-muted mb-0">
                </p>
            </div>

        </div>

        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card p-3 text-center bg-primary text-white stats-card">
                    <h2>@Model.TotalOrders</h2>
                    <p class="m-0">
                        Total Orders
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card p-3 text-center bg-warning text-dark stats-card">
                    <h2>@Model.PendingOrderCount</h2>
                    <p class="m-0">
                        Pending Orders
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card p-3 text-center bg-success text-white stats-card">
                    <h2>@Model.CompletedOrderCount</h2>
                    <p class="m-0">
                        Completed Orders
                    </p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card p-3 text-center bg-info text-dark stats-card">
                    <h2>@Model.TotalConsumables</h2>
                    <p class="m-0">
                        Medical Consumables
                    </p>
                </div>
            </div>

        </div>

        <div class="card p-4 mb-4">

            <div class="d-flex align-items-center mb-3">
                <div class="me-3">
                    <i class="bi bi-person-badge fs-2 text-primary"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">
                    </h5>

                    <span class="text-muted">
                        @Model.Department Department
                    </span>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4">
                    <strong>Name</strong>
                    <p class="text-muted mb-0">
                        @Model.FirstName @Model.LastName
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Job Title</strong>
                    <p class="text-muted mb-0">
                        @Model.JobTitle
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Email</strong>
                    <p class="text-muted mb-0">
                        @Model.Email
                    </p>
                </div>

            </div>

        </div>

        <form method="get"
              asp-controller="StockManager"
              asp-action="StockManagerDashboard"
              class="search-box mb-4">

            <div class="input-group">

                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input name="search"
                       value="@(ViewData["Search"] ?? "")"
                       type="text"
                       placeholder="Search orders or medical consumables..."
                       class="form-control" />

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="StockManager"
                   asp-action="StockManagerDashboard"
                   class="btn btn-secondary">
                    Clear
                </a>

            </div>

        </form>

        <div class="card border-0 shadow-sm p-4 mb-4"
             style="border-radius: 18px;">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h4 class="fw-bold mb-1">
                        <i class="bi bi-clipboard-check text-primary me-2"></i>
                        Recent Stock Audits
                    </h4>

                    <p class="text-muted mb-0 small">
                        Recent stock counting activity across medical stores.
                    </p>
                </div>

                <span class="badge bg-light text-primary px-3 py-2 rounded-pill">
                    <i class="bi bi-clock-history me-1"></i>
                    Recent Activity
                </span>

            </div>


            @if (Model.RecentStockTakes != null && Model.RecentStockTakes.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="text-muted small fw-semibold">
                                    #
                                </th>

                                <th class="text-muted small fw-semibold">
                                    DATE
                                </th>

                                <th class="text-muted small fw-semibold">
                                    CONSUMABLE
                                </th>

                                <th class="text-muted small fw-semibold text-center">
                                    QUANTITY COUNTED
                                </th>

                                <th class="text-muted small fw-semibold">
                                    WARD
                                </th>

                                <th class="text-muted small fw-semibold text-center">
                                    STATUS
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var s in Model.RecentStockTakes)
                            {
                                <tr>
                                    <td>

                                        <span class="fw-semibold text-muted">
                                            @count
                                        </span>

                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="stock-icon bg-light text-primary me-2">
                                                <i class="bi bi-calendar3"></i>
                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @s.Date.ToString("dd MMM yyyy")
                                                </div>

                                                <small class="text-muted">
                                                    Stock Audit
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        @if (s.Consumables != null && s.Consumables.Any())
                                        {
                                            <div>

                                                @foreach (var consumable in s.Consumables)
                                                {
                                                    <div class="fw-semibold">
                                                        @consumable.ConsumableName
                                                    </div>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <span class="quantity-badge">
                                            @s.QuantityCountered
                                        </span>

                                    </td>

                                    <td>

                                        @if (s.Ward != null)
                                        {
                                            <div class="d-flex align-items-center">

                                                <i class="bi bi-hospital text-primary me-2"></i>

                                                <span class="fw-semibold">
                                                    @s.Ward.WardName
                                                </span>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Medical Store
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">

                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Recorded

                                        </span>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="empty-state-icon mb-3">
                        <i class="bi bi-clipboard-x"></i>
                    </div>

                    <h6 class="fw-bold mb-1">
                        No Recent Stock Audits
                    </h6>

                    <p class="text-muted mb-0">
                        There is currently no recent stock activity to display.
                    </p>

                </div>
            }

        </div>


        <style>

            .stock-icon {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .quantity-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 55px;
                padding: 7px 12px;
                border-radius: 50px;
                background-color: #f1f3f5;
                color: #343a40;
                font-weight: 600;
                font-size: 0.85rem;
            }

            .empty-state-icon {
                width: 65px;
                height: 65px;
                margin: 0 auto;
                border-radius: 50%;
                background-color: #f1f3f5;
                color: #adb5bd;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.8rem;
            }

            .table > :not(caption) > * > * {
                padding: 15px 12px;
            }

            .table thead th {
                border-bottom: 1px solid #e9ecef;
                white-space: nowrap;
            }

            .table tbody tr:last-child td {
                border-bottom: none;
            }

        </style>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>