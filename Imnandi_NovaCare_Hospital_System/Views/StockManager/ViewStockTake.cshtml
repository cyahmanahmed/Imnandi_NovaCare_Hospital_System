@model StockTake

@{
    ViewData["Title"] = "View Stock Take";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="col-12 mb-3">
        <a asp-action="ManageStock" class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm" style="border-radius: 80px;">
            <i class="bi bi-arrow-left-circle me-2"></i> Back to Manage Stock
        </a>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Stock Take Details</h4>
        </div>
        <div class="card-body">
            <p><strong>Date:</strong> @Model.Date.ToString("dd/MM/yyyy")</p>
            <p><strong>Ward:</strong> @Model.Ward?.WardName</p>
            <p><strong>Quantity Countered:</strong> @Model.QuantityCountered</p>
            <p><strong>Total Consumables Counted:</strong> @Model.Consumables?.Count()</p>
        </div>
    </div>

    <h4>Consumables</h4>
    @if (!Model.Consumables.Any())
    {
        <div class="alert alert-info">No consumables recorded.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Name</th>
                        <th>Unit</th>
                        <th>Quantity on Hand</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Consumables)
                    {
                        <tr>
                            <td>@c.ConsumableName</td>
                            <td>@c.Unit</td>
                            <td class="text-center">@c.QuantityOnHand</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table-responsive {
        overflow: hidden;
    }

    .btn-outline-primary {
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 500;
    }
</style>
