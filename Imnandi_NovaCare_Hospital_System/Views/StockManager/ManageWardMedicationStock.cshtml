@using Imnandi_NovaCare_Hospital_System.Models
@model List<WardMedicationStock>

@{
    ViewData["Title"] = "Manage Ward Medication Stock";

    var wards = ViewBag.Wards as List<Ward>
                ?? new List<Ward>();

    var medications = ViewBag.Medications as List<Medication>
                     ?? new List<Medication>();

    int? selectedWardId = ViewBag.SelectedWardId as int?;
    string selectedWardName = ViewBag.SelectedWardName as string ?? "";

    bool wardSelected = selectedWardId.HasValue;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Manage Ward Medication Stock</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        body {
            background: #f5f7fb;
            font-family: Arial, sans-serif;
            color: #26364d;
        }

        .page-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 28px 20px 60px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 18px;
            border: 1px solid #4969ff;
            border-radius: 25px;
            color: #4969ff;
            background: white;
            text-decoration: none;
            font-size: 14px;
            transition: 0.2s;
            margin-bottom: 20px;
        }

            .back-button:hover {
                background: #4969ff;
                color: white;
            }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 22px;
        }

        .page-title {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #263f66;
        }

        .page-title i {
            color: #2563eb;
            font-size: 30px;
        }

        .page-subtitle {
            margin: 5px 0 0 42px;
            color: #73829a;
            font-size: 14px;
        }

        .top-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .report-button {
            border: 1px solid #4969ff;
            color: #4969ff;
            background: white;
            border-radius: 25px;
            padding: 9px 18px;
            font-size: 14px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

            .report-button:hover {
                background: #4969ff;
                color: white;
            }

        .selection-card,
        .assign-card,
        .stock-card,
        .empty-card {
            background: white;
            border: 1px solid #e1e7f0;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(30, 55, 90, 0.05);
        }

        .selection-card {
            padding: 22px;
            margin-bottom: 18px;
        }

        .section-label {
            font-size: 14px;
            font-weight: 600;
            color: #263f66;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .section-label i {
                color: #2563eb;
            }

        .ward-select {
            height: 46px;
            border: 1px solid #4969ff;
            border-radius: 7px;
            box-shadow: none !important;
            font-size: 14px;
        }

        .view-button {
            height: 46px;
            border: none;
            border-radius: 7px;
            background: #526eea;
            color: white;
            padding: 0 25px;
            font-size: 14px;
            font-weight: 600;
        }

            .view-button:hover {
                background: #405bd2;
            }

        .alert-box {
            border-radius: 8px;
            margin-bottom: 18px;
        }

        .assign-card {
            padding: 22px;
            margin-bottom: 20px;
        }

        .assign-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }

        .assign-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #edf3ff;
            color: #3565e8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .assign-title {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            color: #334d72;
        }

        .assign-description {
            margin: 3px 0 0;
            color: #8290a5;
            font-size: 13px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #52647d;
            margin-bottom: 7px;
        }

        .form-control,
        .form-select {
            border: 1px solid #d7deea;
            border-radius: 7px;
            height: 44px;
            font-size: 14px;
            box-shadow: none !important;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #4969ff;
            }

        .assign-button {
            height: 44px;
            border: none;
            border-radius: 7px;
            background: #526eea;
            color: white;
            padding: 0 22px;
            font-weight: 600;
            font-size: 14px;
        }

            .assign-button:hover {
                background: #405bd2;
            }

        .central-stock {
            margin-top: 7px;
            font-size: 12px;
            color: #7b8799;
        }

            .central-stock strong {
                color: #2563eb;
            }

        .stock-card {
            overflow: hidden;
        }

        .stock-header {
            padding: 20px 22px;
            border-bottom: 1px solid #e2e7ef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stock-title {
            margin: 0;
            font-size: 19px;
            font-weight: 700;
            color: #334d72;
        }

        .stock-subtitle {
            margin: 4px 0 0;
            font-size: 13px;
            color: #8290a5;
        }

        .item-count {
            background: #eef4ff;
            color: #4167d9;
            border-radius: 20px;
            padding: 7px 14px;
            font-size: 12px;
            font-weight: 600;
        }

        .table {
            margin: 0;
        }

            .table thead th {
                background: #f8f9fb;
                color: #52647d;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.3px;
                border-bottom: 1px solid #dfe5ee;
                padding: 14px 16px;
                white-space: nowrap;
            }

            .table tbody td {
                padding: 15px 16px;
                vertical-align: middle;
                border-bottom: 1px solid #edf0f5;
                font-size: 14px;
                color: #60718b;
            }

            .table tbody tr:last-child td {
                border-bottom: none;
            }

        .medicine-name {
            color: #334d72;
            font-weight: 600;
        }

        .medicine-description {
            color: #8995a8;
            font-size: 12px;
            margin-top: 3px;
        }

        .quantity-badge {
            display: inline-block;
            min-width: 65px;
            text-align: center;
            padding: 7px 12px;
            border-radius: 7px;
            background: #eaf7ef;
            color: #15945b;
            font-weight: 700;
        }

        .unit-badge {
            background: #f1f3f7;
            color: #5e6d83;
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 11px;
        }

        .empty-card {
            padding: 55px 25px;
            text-align: center;
        }

        .empty-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 15px;
            border-radius: 50%;
            background: #edf3ff;
            color: #4b6ff1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
        }

        .empty-title {
            font-size: 17px;
            font-weight: 700;
            color: #425675;
            margin-bottom: 5px;
        }

        .empty-text {
            font-size: 13px;
            color: #8995a8;
            margin: 0;
        }

        .selected-ward-badge {
            background: #eef4ff;
            color: #4569d8;
            border-radius: 20px;
            padding: 7px 14px;
            font-size: 12px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="page-container">

        <a asp-controller="StockManager"
           asp-action="StockManagerDashboard"
           class="back-button">
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>

        <div class="page-header">

            <div>
                <h1 class="page-title">
                    <i class="bi bi-capsule"></i>
                    Ward Medication Stock
                </h1>

                <p class="page-subtitle">
                    Manage and allocate medication stock across individual hospital wards.
                </p>
            </div>

            <div class="top-actions">
                @if (wardSelected)
                {
                    <a asp-controller="Reports"
                       asp-action="WardMedicationFullReport"
                       asp-route-wardId="@selectedWardId"
                       class="report-button"
                       title="Download medication stock report">
                        <i class="bi bi-file-earmark-arrow-down"></i>
                        Download Report
                    </a>
                }
                else
                {
                    <span class="report-button"
                          style="opacity: 0.5; cursor: not-allowed;"
                          title="Select a ward first">
                        <i class="bi bi-file-earmark-arrow-down"></i>
                        Download Report
                    </span>
                }
            </div>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show alert-box">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show alert-box">
                <i class="bi bi-exclamation-circle me-2"></i>
                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="selection-card">

            <div class="section-label">
                <i class="bi bi-building"></i>
                Select Ward
            </div>

            <form asp-controller="StockManager"
                  asp-action="ManageWardMedicationStock"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-9">

                        <label class="form-label">
                            Ward
                        </label>

                        <select name="wardId"
                                class="form-select ward-select"
                                required>

                            <option value="">
                                Select a Ward
                            </option>

                            @foreach (var ward in wards)
                            {
                                if (selectedWardId == ward.WardId)
                                {
                                    <option value="@ward.WardId" selected>
                                        @ward.WardName
                                    </option>
                                }
                                else
                                {
                                    <option value="@ward.WardId">
                                        @ward.WardName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-3">

                        <button type="submit"
                                class="view-button w-100">
                            <i class="bi bi-eye me-2"></i>
                            View Medication
                        </button>

                    </div>

                </div>

            </form>

        </div>


        @if (wardSelected)
        {
            <div class="assign-card">

                <div class="assign-header">

                    <div class="assign-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <div>
                        <h2 class="assign-title">
                            Allocate Medicine to Ward
                        </h2>

                        <p class="assign-description">
                            Add medication from the central medical store to
                            <strong>@selectedWardName</strong>.
                        </p>
                    </div>

                </div>

                <form asp-controller="StockManager"
                      asp-action="AssignMedicationToWard"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="wardId"
                           value="@selectedWardId" />

                    <div class="row g-3 align-items-end">

                        <div class="col-md-6">

                            <label class="form-label">
                                Medicine
                            </label>

                            <select name="medicationId"
                                    id="medicationId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Medicine
                                </option>

                                @foreach (var medication in medications)
                                {
                                    <option value="@medication.MedicationId"
                                            data-stock="@(@medication.QuantityOnHand ?? 0)">
                                        @medication.MedicationName
                                    </option>
                                }

                            </select>

                            <div class="central-stock" id="centralStock">
                                Select a medicine to see available central stock.
                            </div>

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                Quantity to Send
                            </label>

                            <input type="number"
                                   name="quantity"
                                   id="quantity"
                                   class="form-control"
                                   min="1"
                                   step="1"
                                   placeholder="Enter quantity"
                                   required />

                        </div>

                        <div class="col-md-3">

                            <button type="submit"
                                    class="assign-button w-100">
                                <i class="bi bi-plus-circle me-2"></i>
                                Assign Medicine
                            </button>

                        </div>

                    </div>

                </form>

            </div>


            <div class="stock-card">

                <div class="stock-header">

                    <div>
                        <h2 class="stock-title">
                            @selectedWardName Medication Stock
                        </h2>

                        <p class="stock-subtitle">
                            Medication currently allocated to this ward.
                        </p>
                    </div>

                    <span class="item-count">
                        @Model.Count Item@(Model.Count == 1 ? "" : "s")
                    </span>

                </div>


                @if (Model.Any())
                {
                    <div class="table-responsive">

                        <table class="table">

                            <thead>
                                <tr>
                                    <th style="width: 55px;">#</th>
                                    <th>MEDICINE</th>
                                    <th>DESCRIPTION</th>
                                    <th>DOSAGE FORM</th>
                                    <th>MANUFACTURER</th>
                                    <th>QUANTITY</th>
                                    <th>EXPIRY DATE</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    int counter = 1;
                                }

                                @foreach (var stock in Model)
                                {
                                    <tr>

                                        <td>
                                            <span class="unit-badge">
                                                @counter
                                            </span>
                                        </td>

                                        <td>
                                            <div class="medicine-name">
                                                @(stock.Medication?.MedicationName ?? "N/A")
                                            </div>
                                        </td>

                                        <td>
                                            <div class="medicine-description">
                                                @(stock.Medication?.Description ?? "No description available")
                                            </div>
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(stock.Medication?.DosageForm))
                                            {
                                                <span class="unit-badge">
                                                    @stock.Medication.DosageForm
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="medicine-description">
                                                    N/A
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @(stock.Medication?.Manufacturer ?? "N/A")
                                        </td>

                                        <td>
                                            <span class="quantity-badge">
                                                @stock.QuantityInWard.ToString("N0")
                                            </span>
                                        </td>

                                        <td>
                                            @if (stock.Medication?.ExpiryDate.HasValue == true)
                                            {
                                                @stock.Medication.ExpiryDate.Value.ToString("dd MMM yyyy")
                                            }
                                            else
                                            {
                                                <span class="medicine-description">
                                                    N/A
                                                </span>
                                            }
                                        </td>

                                    </tr>

                                    counter++;
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-card"
                         style="border: none; box-shadow: none;">

                        <div class="empty-icon">
                            <i class="bi bi-capsule"></i>
                        </div>

                        <div class="empty-title">
                            No Medication Assigned
                        </div>

                        <p class="empty-text">
                            There is currently no medication allocated to
                            @selectedWardName.
                        </p>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-card">

                <div class="empty-icon">
                    <i class="bi bi-hospital"></i>
                </div>

                <div class="empty-title">
                    Select a Ward
                </div>

                <p class="empty-text">
                    Select a ward above to view and manage its medication stock.
                </p>

            </div>
        }

    </div>

    <script>
        const medicationSelect = document.getElementById("medicationId");
        const centralStock = document.getElementById("centralStock");
        const quantityInput = document.getElementById("quantity");

        if (medicationSelect) {

            medicationSelect.addEventListener("change", function () {

                const selectedOption =
                    medicationSelect.options[medicationSelect.selectedIndex];

                if (!selectedOption || !selectedOption.value) {

                    centralStock.innerHTML =
                        "Select a medicine to see available central stock.";

                    quantityInput.removeAttribute("max");

                    return;
                }

                const stock =
                    selectedOption.getAttribute("data-stock") || "0";

                centralStock.innerHTML =
                    "Available central stock: <strong>" +
                    Number(stock).toLocaleString() +
                    "</strong>";

                quantityInput.setAttribute("max", stock);

            });

        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>