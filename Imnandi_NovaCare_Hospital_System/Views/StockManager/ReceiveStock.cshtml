@model IEnumerable<Order>

@{
    ViewData["Title"] = "Receive Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="col-12 mb-3">
        <a asp-controller="StockManager" asp-action="StockManagerDashboard"
           class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
           style="border-radius: 80px;">
            <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Receive Stock</h2>
        <a asp-action="ManageOrders" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
    </div>

    <form method="get" asp-action="ReceiveStock" class="mb-3">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search by Order Name..." value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No pending orders found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Order Name</th>
                        <th>Description</th>
                        <th>Ward</th>
                        <th>Items</th>
                        <th>Quantities Requested</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderName</td>
                            <td>@order.Description</td>
                            <td>@(order.Ward?.WardName ?? "N/A")</td>
                            <td>
                                @if (order.OrderItems != null && order.OrderItems.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li>@item.Consumable?.ConsumableName ?? "N/A"</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>
                            <td>
                                @if (order.OrderItems != null && order.OrderItems.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li>@(item.QuantityRequested)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ReceiveOrder" method="post" class="d-inline">
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check-circle"></i> Receive
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .btn-outline-primary {
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 500;
    }
</style>
