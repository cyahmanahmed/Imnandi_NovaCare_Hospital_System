@model IEnumerable<Notification>

@{
    ViewData["Title"] = "Manage Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="col-12 mb-3">
        <a asp-controller="StockManager" asp-action="ManageOrders"
           class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
           style="border-radius: 80px;">
            <i class="bi bi-house-door-fill me-2"></i> Back
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notifications</h2>
    </div>

    <form method="get" asp-action="ManageNotification" class="mb-3">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search notifications..." value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No unread notifications found.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Message</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var notification in Model)
                    {
                        <tr>
                            <td>@notification.Message</td>
                            <td class="text-center">@notification.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-center">
                                <form asp-action="MarkAsRead" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@notification.NotificationId" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check-circle me-1"></i> Mark as Read
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .btn-outline-primary {
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .table-responsive {
        overflow: hidden;
    }
</style>
