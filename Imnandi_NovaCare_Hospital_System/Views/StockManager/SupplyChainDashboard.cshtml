@using Imnandi_NovaCare_Hospital_System.Models
@model StockManagerDashboardViewModel

@{
    ViewData["Title"] = "Supply Chain Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Supply Chain Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            overflow-y: visible;
        }

        .sm-sidebar {
            background-color: #2c3e50;
            width: 250px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 1rem;
            color: white;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

            .sm-sidebar a {
                display: block;
                padding: 0.9rem 1.25rem;
                color: white;
                text-decoration: none;
                font-size: 0.95rem;
            }

                .sm-sidebar a:hover {
                    background-color: #34495e;
                }

            .sm-sidebar .section-title {
                padding: 0.75rem 1.25rem;
                text-transform: uppercase;
                font-size: 0.8rem;
                color: #adb5bd;
            }

        .sm-dashboard-content {
            margin-left: 250px;
            padding: 2rem;
        }

        .dashboard-header {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .06);
        }

            .dashboard-header h1 {
                font-weight: 700;
                margin-bottom: .35rem;
            }

        .department-badge {
            display: inline-block;
            padding: .4rem .75rem;
            border-radius: 20px;
            background-color: #e7f1ff;
            color: #0d6efd;
            font-size: .85rem;
            font-weight: 600;
        }

        .card {
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .06);
        }

        .stats-card {
            min-height: 125px;
        }

            .stats-card h2 {
                font-size: 2rem;
                margin: 0;
                font-weight: 700;
            }

            .stats-card p {
                margin-top: .35rem;
            }

        .section-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

            .section-card-header h4 {
                margin: 0;
                font-weight: 700;
            }

        .table {
            margin-bottom: 0;
        }

            .table th {
                font-size: .85rem;
                text-transform: uppercase;
                color: #6c757d;
                white-space: nowrap;
            }

            .table td {
                vertical-align: middle;
            }

        .search-box input {
            height: 45px;
            border-radius: 7px 0 0 7px;
        }

        .search-box button {
            height: 45px;
        }

        .btn-action {
            background-color: #0d6efd;
            color: white;
            border-radius: 6px;
            padding: 5px 12px;
            text-decoration: none;
            font-size: .85rem;
        }

            .btn-action:hover {
                background-color: #0a58ca;
                color: white;
            }

        .empty-state {
            padding: 2rem;
            text-align: center;
            color: #6c757d;
        }

        .stock-warning {
            font-weight: 700;
            color: #dc3545;
        }

        .stock-good {
            font-weight: 600;
            color: #198754;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: .65rem 0;
            border-bottom: 1px solid #eee;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            color: #6c757d;
        }

        .info-value {
            font-weight: 600;
        }

        .table-responsive {
            border-radius: 8px;
        }
    </style>
</head>

<body>

    <div class="sm-sidebar">

        <h3 class="text-center mb-4 fw-bold">
            Stock Manager Panel
        </h3>

        <a asp-controller="StockManager"
           asp-action="ManageOrders"
           class="nav-link">
            <i class="bi bi-cart-check me-2"></i>
            Manage Consumables
        </a>

        <a asp-controller="StockManager"
           asp-action="ManageMedicineOrders"
           class="nav-link">
            <i class="bi bi-capsule-pill me-2"></i>
            Manage Medicine Orders
        </a>

        <a asp-controller="StockManager"
           asp-action="ManageSuppliers"
           class="nav-link">
            <i class="bi bi-building me-2"></i>
            Manage Suppliers
        </a>

        <a asp-controller="StockManager"
           asp-action="TrackDeliveries"
           class="nav-link">
            <i class="bi bi-truck me-2"></i>
            Track Deliveries
        </a>

        <a asp-controller="StockManager"
           asp-action="ViewAlerts">
            <i class="bi bi-bell me-2"></i>
            View Alerts
        </a>

        <h6 class="section-title">
            Settings
        </h6>

        <a asp-controller="StockManager"
           asp-action="Profile">
            <i class="bi bi-gear me-2"></i>
            Profile
        </a>

        <a href="/Identity/Account/Logout">
            <i class="bi bi-box-arrow-right me-2"></i>
            Log Out
        </a>

    </div>


    <div class="sm-dashboard-content">

        <div class="dashboard-header">
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1 class="fw-bold mb-1">
                        Welcome, @Model.FirstName @Model.LastName
                    </h1>

                    <p class="text-muted mb-0">
                        Supply chain Stock Management Dashboard
                    </p>
                </div>

            </div>
        </div>
       
        <div class="row g-3 mb-4">

            <div class="col-md-3">

                <div class="card stats-card p-4 text-center bg-primary text-white">

                    <i class="bi bi-cart-check fs-3 mb-2"></i>

                    <h2>
                        @Model.TotalOrders
                    </h2>

                    <p>
                        Total Orders
                    </p>

                </div>

            </div>


            <div class="col-md-3">

                <div class="card stats-card p-4 text-center bg-warning text-dark">

                    <i class="bi bi-hourglass-split fs-3 mb-2"></i>

                    <h2>
                        @Model.PendingOrderCount
                    </h2>

                    <p>
                        Pending Orders
                    </p>

                </div>

            </div>


            <div class="col-md-3">

                <div class="card stats-card p-4 text-center bg-success text-white">

                    <i class="bi bi-check-circle fs-3 mb-2"></i>

                    <h2>
                        @Model.CompletedOrderCount
                    </h2>

                    <p>
                        Completed Orders
                    </p>

                </div>

            </div>


            <div class="col-md-3">

                <div class="card stats-card p-4 text-center bg-info text-dark">

                    <i class="bi bi-box-seam fs-3 mb-2"></i>

                    <h2>
                        @Model.TotalConsumables
                    </h2>

                    <p>
                        Consumables
                    </p>

                </div>

            </div>

        </div>

        <div class="card p-4 mb-4">

            <div class="d-flex align-items-center mb-3">
                <div class="me-3">
                    <i class="bi bi-person-badge fs-2 text-primary"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">
                    </h5>

                    <span class="text-muted">
                        Supply chain Department
                    </span>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4">
                    <strong>Name</strong>
                    <p class="text-muted mb-0">
                        @Model.FirstName @Model.LastName
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Job Title</strong>
                    <p class="text-muted mb-0">
                        @Model.JobTitle
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Email</strong>
                    <p class="text-muted mb-0">
                        @Model.Email
                    </p>
                </div>

            </div>

        </div>

        <div class="card p-4 mb-4">

            <div class="section-card-header">

                <h4>
                    <i class="bi bi-search me-2 text-primary"></i>
                    Search
                </h4>

            </div>

            <form method="get"
                  asp-controller="StockManager"
                  asp-action="StockManagerDashboard"
                  class="search-box">

                <div class="input-group">

                    <input name="search"
                           value="@(ViewData["Search"] ?? "")"
                           type="text"
                           class="form-control"
                           placeholder="Search orders or consumables..." />

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>

                    <a asp-controller="StockManager"
                       asp-action="StockManagerDashboard"
                       class="btn btn-secondary d-flex align-items-center">
                        <i class="bi bi-x-circle me-1"></i>
                        Clear
                    </a>

                </div>

            </form>

        </div>


        <div class="card p-4 mb-4">

            <div class="section-card-header">

                <h4>
                    <i class="bi bi-hourglass-split text-warning me-2"></i>
                    Pending Orders
                </h4>

                <span class="badge bg-warning text-dark">
                    @Model.PendingOrderCount
                </span>

            </div>

            @if (Model.PendingOrders.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Order Name</th>
                                <th>Description</th>
                                <th>Items</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model.PendingOrders)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            #@order.OrderId
                                        </strong>
                                    </td>

                                    <td>
                                        @order.OrderName
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(order.Description)
                                                                        ? "No description"
                                                                        : order.Description)
                            </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @order.OrderItems.Count
                                        </span>
                                    </td>

                                    <td>
                                        @order.Date.ToString("dd MMM yyyy")
                                    </td>

                                </tr>
                                                }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-check2-circle fs-2 d-block mb-2"></i>

                    <p class="mb-0">
                        No pending orders.
                    </p>

                </div>
            }

        </div>


        <div class="card p-4 mb-4">

            <div class="section-card-header">

                <h4>
                    <i class="bi bi-check-circle text-success me-2"></i>
                    Completed Orders
                </h4>

                <span class="badge bg-success">
                    @Model.CompletedOrderCount
                </span>

            </div>

            @if (Model.CompletedOrders.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Order Name</th>
                                <th>Description</th>
                                <th>Items</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model.CompletedOrders)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            #@order.OrderId
                                        </strong>
                                    </td>

                                    <td>
                                        @order.OrderName
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(order.Description)
                                                                        ? "No description"
                                                                        : order.Description)
                            </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @order.OrderItems.Count
                                        </span>
                                    </td>

                                    <td>
                                        @order.Date.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Received
                                        </span>

                                    </td>

                                </tr>
                                                }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                    <p class="mb-0">
                        No completed orders.
                    </p>

                </div>
            }

        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>