@model IEnumerable<Consumable>

@{
    ViewData["Title"] = "Manage Consumables";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="col-12 mb-3">
        <a asp-controller="StockManager" asp-action="StockManagerDashboard"
           class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
           style="border-radius: 80px;">
            <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Consumables</h2>
        <div>
            <a asp-action="CreateConsumable" class="btn btn-success me-2">
                <i class="bi bi-plus-circle"></i> Create New Consumable
            </a>
            <a asp-action="ManageNotification" class="btn btn-warning">
                <i class="bi bi-exclamation-triangle"></i> View Low-Stock Alerts
            </a>
        </div>
    </div>

    <form method="get" asp-action="ManageConsumables" class="mb-3">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search by name or description..." value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No consumables found.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Quantity On Hand</th>
                        <th>Unit</th>
                        <th>Expiry Date</th>
                        <th>Minimum Required</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var consumable in Model)
                    {
                        <tr>
                            <td>@consumable.ConsumableName</td>
                            <td>@consumable.Description</td>
                            <td class="text-center">
                                @consumable.QuantityOnHand
                                @if (consumable.QuantityOnHand <= consumable.MinimumConsumables)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Low Stock</span>
                                }
                            </td>
                            <td class="text-center">@consumable.Unit</td>
                            <td class="text-center">
                                @if (consumable.ExpiryDate < DateOnly.FromDateTime(DateTime.Now))
                                {
                                    <span class="badge bg-danger">Expired</span>
                                }
                                else
                                {
                                    @consumable.ExpiryDate.ToString("dd/MM/yyyy")
                                }
                            </td>
                            <td class="text-center">@consumable.MinimumConsumables</td>
                            <td class="text-center">
                                <a asp-action="EditConsumable" asp-route-id="@consumable.ConsumableId" class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </a>

                                @if (!consumable.IsDeleted)
                                {
                                    <form asp-action="DeleteConsumable" asp-route-id="@consumable.ConsumableId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger me-1">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="RestoreConsumable" asp-route-id="@consumable.ConsumableId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .btn-outline-primary {
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .table-responsive {
        overflow: hidden;
    }
</style>
