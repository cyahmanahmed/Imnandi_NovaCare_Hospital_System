                    and special insights from our experts.
                </p>

            </div>

        </section>

        <section id="investors" class="section">

            <div class="home-bg-wrapper">
                <img class="home-bg"
                     src="/images/Investorspic.jpg"
                     alt="Investors Image">
            </div>

            <div class="text-card">

                <h2>Investors</h2>

                <p>
                    Imnandi NovaCare Medical Center values partnerships that
                    drive healthcare innovation. We provide transparent
                    financial reporting, investment opportunities, and
                    sustainable growth plans for our stakeholders.
                </p>

                <p>
                    Our investors are crucial to expanding our services,
                    research programs, and advanced patient care technologies.
                </p>

            </div>

        </section>

        <section id="contact" class="section">

            <div class="home-bg-wrapper">
                <img class="home-bg"
                     src="/images/contact_pic.jpg"
                     alt="Contact Image">
            </div>

            <div class="text-card">

                <h2>Contact Us</h2>

                <p>
                    Address: 123 Imnandi Hill, Uitenhage, South Africa
                </p>

                <p>
                    Email: info@imnandi.co.za |
                    Phone: +27 00 000 0000
                </p>

                <p>
                    Follow us on our social media channels for updates,
                    events, and community programs.
                </p>

            </div>

        </section>

    </div>

    <button type="button"
            class="chatbot-button"
            id="chatbotButton"
            aria-label="Open hospital assistant">

        <i class="fa-solid fa-comments"></i>

    </button>

    <div class="chatbot-window" id="chatbotWindow">

        <div class="chatbot-header">

            <div class="chatbot-header-left">

                <div class="chatbot-avatar">
                    <i class="fa-solid fa-user-doctor"></i>
                </div>

                <div>
                    <h5>NovaCare Assistant</h5>
                    <small>Hospital Information Assistant</small>
                </div>

            </div>

            <button type="button"
                    class="chatbot-close"
                    id="chatbotClose"
                    aria-label="Close chatbot">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

        <div class="chatbot-messages"
             id="chatbotMessages">

            <div class="chat-message bot">

                <div class="message-bubble">
                    Hello! Welcome to Imnandi NovaCare Medical Center.
                    How can I help you today?
                </div>

            </div>

            <div class="chat-message bot">

                <div class="message-bubble">
                    Select a common question below or type your own question.
                </div>

            </div>

        </div>

        <div class="quick-questions">

            <div class="quick-title">
                HOW CAN WE HELP?
            </div>

            <div class="quick-buttons">

                <button type="button"
                        class="quick-btn"
                        data-question="What services do you offer?">
                    <i class="fa-solid fa-stethoscope me-1"></i>
                    Services
                </button>

                <button type="button"
                        class="quick-btn"
                        data-question="What are your opening hours?">
                    <i class="fa-regular fa-clock me-1"></i>
                    Opening Hours
                </button>

                <button type="button"
                        class="quick-btn"
                        data-question="Where are you located?">
                    <i class="fa-solid fa-location-dot me-1"></i>
                    Location
                </button>

                <button type="button"
                        class="quick-btn"
                        data-question="How can I contact the hospital?">
                    <i class="fa-solid fa-phone me-1"></i>
                    Contact
                </button>

                <button type="button"
                        class="quick-btn"
                        data-question="How do I make an appointment with a doctor?">
                    <i class="fa-solid fa-user-doctor me-1"></i>
                    Appointments
                </button>

                <button type="button"
                        class="quick-btn"
                        data-question="How can I apply for a job?">
                    <i class="fa-solid fa-briefcase me-1"></i>
                    Careers
                </button>

                <button type="button"
                        class="quick-btn"
                        data-question="How do I access the hospital system?">
                    <i class="fa-solid fa-right-to-bracket me-1"></i>
                    System Login
                </button>

                <button type="button"
                        class="quick-btn"
                        data-question="What should I do in an emergency?">
                    <i class="fa-solid fa-truck-medical me-1"></i>
                    Emergency
                </button>

            </div>

        </div>

        <div class="chatbot-input-area">

            <input type="text"
                   id="chatbotInput"
                   class="chatbot-input"
                   placeholder="Type your question..."
                   autocomplete="off">

            <button type="button"
                    class="chatbot-send"
                    id="chatbotSend"
                    aria-label="Send message">

                <i class="fa-solid fa-paper-plane"></i>

            </button>

        </div>

    </div>

    <script>

        const chatbotButton = document.getElementById("chatbotButton");
        const chatbotWindow = document.getElementById("chatbotWindow");
        const chatbotClose = document.getElementById("chatbotClose");
        const chatbotInput = document.getElementById("chatbotInput");
        const chatbotSend = document.getElementById("chatbotSend");
        const chatbotMessages = document.getElementById("chatbotMessages");
        const quickButtons = document.querySelectorAll(".quick-btn");

        chatbotButton.addEventListener("click", function () {

            chatbotWindow.classList.toggle("active");

            if (chatbotWindow.classList.contains("active")) {
                chatbotInput.focus();
            }

        });

        chatbotClose.addEventListener("click", function () {

            chatbotWindow.classList.remove("active");

        });

        function addMessage(message, sender) {

            const wrapper = document.createElement("div");

            wrapper.className = "chat-message " + sender;

            const bubble = document.createElement("div");

            bubble.className = "message-bubble";

            bubble.textContent = message;

            wrapper.appendChild(bubble);

            chatbotMessages.appendChild(wrapper);

            chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
        }

        function addTypingMessage() {

            const wrapper = document.createElement("div");

            wrapper.className = "chat-message bot";
            wrapper.id = "typingMessage";

            const bubble = document.createElement("div");

            bubble.className = "message-bubble";

            bubble.innerHTML =
                '<span class="typing">' +
                '<span></span>' +
                '<span></span>' +
                '<span></span>' +
                '</span>';

            wrapper.appendChild(bubble);

            chatbotMessages.appendChild(wrapper);

            chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
        }

        function removeTypingMessage() {

            const typingMessage =
                document.getElementById("typingMessage");

            if (typingMessage) {
                typingMessage.remove();
            }
        }

        function getBotResponse(question) {

            const text = question.toLowerCase().trim();

            if (
                text.includes("hello") ||
                text.includes("hi") ||
                text.includes("hey") ||
                text.includes("good morning") ||
                text.includes("good afternoon") ||
                text.includes("good evening")
            ) {
                return "Hello! Welcome to Imnandi NovaCare Medical Center. How can I assist you today?";
            }

            if (
                text.includes("service") ||
                text.includes("services") ||
                text.includes("offer") ||
                text.includes("treatment") ||
                text.includes("treatments") ||
                text.includes("healthcare") ||
                text.includes("medical care")
            ) {
                return "Imnandi NovaCare provides a wide range of healthcare services, including doctor consultations, nursing care, medication management, patient admissions, treatments, medical monitoring and other patient care services.";
            }

            if (
                text.includes("location") ||
                text.includes("located") ||
                text.includes("where") ||
                text.includes("address") ||
                text.includes("place")
            ) {
                return "Imnandi NovaCare Medical Center is located at 123 Imnandi Hill, Uitenhage, South Africa.";
            }

            if (
                text.includes("contact") ||
                text.includes("phone") ||
                text.includes("telephone") ||
                text.includes("email") ||
                text.includes("call") ||
                text.includes("number")
            ) {
                return "You can contact Imnandi NovaCare Medical Center at info@imnandi.co.za or by phone at +27 00 000 0000.";
            }

            if (
                text.includes("hour") ||
                text.includes("hours") ||
                text.includes("open") ||
                text.includes("opening") ||
                text.includes("close") ||
                text.includes("closing") ||
                text.includes("time") ||
                text.includes("when are you")
            ) {
                return "Imnandi NovaCare Medical Center provides healthcare services 24 hours a day, 7 days a week. Emergency services are available at all times. General outpatient and administrative services operate Monday to Friday from 08:00 to 17:00. Some departments may have different operating hours, so please contact the hospital for specific department times.";
            }

            if (
                text.includes("emergency") ||
                text.includes("urgent") ||
                text.includes("ambulance") ||
                text.includes("accident")
            ) {
                return "If you are experiencing a medical emergency, please seek immediate emergency medical assistance or go directly to the nearest emergency department. This chatbot cannot provide emergency medical care.";
            }

            if (
                text.includes("career") ||
                text.includes("careers") ||
                text.includes("job") ||
                text.includes("jobs") ||
                text.includes("work") ||
                text.includes("vacancy") ||
                text.includes("vacancies") ||
                text.includes("employment")
            ) {
                return "Imnandi NovaCare offers opportunities for doctors, nurses, medical technicians, administrative staff and other healthcare professionals. Please visit the Careers section of our website to learn more about opportunities.";
            }

            if (
                text.includes("apply") ||
                text.includes("application") ||
                text.includes("how do i apply")
            ) {
                return "To apply for a position, please visit our Careers section and review the available opportunities. Follow the application instructions provided for the position you are interested in.";
            }

            if (
                text.includes("login") ||
                text.includes("log in") ||
                text.includes("account") ||
                text.includes("system") ||
                text.includes("sign in")
            ) {
                return "Authorized staff members can access the hospital management system using the Login button on the home page. If you are having difficulty accessing your account, please contact the hospital administrator.";
            }

            if (
                text.includes("investor") ||
                text.includes("investors") ||
                text.includes("investment") ||
                text.includes("financial")
            ) {
                return "Our Investors section provides information about healthcare innovation, financial reporting, investment opportunities and sustainable growth at Imnandi NovaCare Medical Center.";
            }

            if (
                text.includes("news") ||
                text.includes("new") ||
                text.includes("event") ||
                text.includes("events") ||
                text.includes("announcement") ||
                text.includes("announcements")
            ) {
                return "You can find hospital news, healthcare updates, events, announcements and community initiatives in our News Hub.";
            }

            if (
                text.includes("doctor") ||
                text.includes("doctors") ||
                text.includes("appointment") ||
                text.includes("appointments") ||
                text.includes("consultation") ||
                text.includes("consult")
            ) {
                return "For doctor appointments and availability, please contact Imnandi NovaCare Medical Center directly. Authorized users may also use the hospital management system to manage appointments and schedules.";
            }

            if (
                text.includes("patient") ||
                text.includes("patients") ||
                text.includes("admission") ||
                text.includes("admitted")
            ) {
                return "Our hospital provides patient admission, nursing care, medical consultations, treatments, medication management and ongoing patient monitoring. For information about a specific patient, please contact the hospital directly.";
            }

            if (
                text.includes("pharmacy") ||
                text.includes("medicine") ||
                text.includes("medication") ||
                text.includes("prescription")
            ) {
                return "Our healthcare services include medication and prescription management. For prescription or pharmacy-related enquiries, please contact the hospital directly or speak with the appropriate medical department.";
            }

            if (
                text.includes("about") ||
                text.includes("hospital") ||
                text.includes("who are you")
            ) {
                return "Imnandi NovaCare Medical Center is committed to providing quality healthcare through compassionate patient care, modern medical facilities, multidisciplinary healthcare teams and innovative healthcare solutions.";
            }

            if (
                text.includes("thank") ||
                text.includes("thanks")
            ) {
                return "You're very welcome! If you have any other questions about Imnandi NovaCare, feel free to ask.";
            }

            if (
                text.includes("bye") ||
                text.includes("goodbye")
            ) {
                return "Thank you for visiting Imnandi NovaCare Medical Center. Have a wonderful day!";
            }

            return "I can help you with information about our services, location, contact details, opening hours, careers, appointments, patients, pharmacy, news, investors and system access. Please try asking me a question about one of these areas.";
        }

        function sendMessage(question) {

            const message = question.trim();

            if (!message) {
                return;
            }

            addMessage(message, "user");

            chatbotInput.value = "";

            addTypingMessage();

            setTimeout(function () {

                removeTypingMessage();

                const response = getBotResponse(message);

                addMessage(response, "bot");

            }, 700);
        }

        chatbotSend.addEventListener("click", function () {

            sendMessage(chatbotInput.value);

        });

        chatbotInput.addEventListener("keydown", function (event) {

            if (event.key === "Enter") {

                event.preventDefault();

                sendMessage(chatbotInput.value);

            }

        });

        quickButtons.forEach(function (button) {

            button.addEventListener("click", function () {

                const question =
                    button.getAttribute("data-question");

                sendMessage(question);

            });

        });

    </script>

</body>
</html>