@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <div class="mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
            </div>

            <div>
                <h1 class="fw-bold mb-1">Privacy Policy</h1>
                <p class="text-muted mb-0">
                    Hospital Management System
                </p>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            <section class="mb-5">
                <h4 class="fw-bold mb-3">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                    Privacy
                </h4>

                <p class="text-muted">
                    The Hospital Management System is designed with privacy and
                    information security in mind. Information accessed through
                    the system is intended for authorised use only.
                </p>

                <p class="text-muted mb-0">
                    Users are expected to use the system responsibly and in
                    accordance with the policies and procedures applicable to
                    their organisation.
                </p>
            </section>

            <hr>

            <section class="my-5">
                <h4 class="fw-bold mb-3">
                    <i class="bi bi-shield-check text-primary me-2"></i>
                    Information Security
                </h4>

                <p class="text-muted">
                    Appropriate security measures are used to help protect
                    information within the system from unauthorised access,
                    modification, disclosure, or misuse.
                </p>

                <p class="text-muted mb-0">
                    Access to system functionality is controlled according to
                    user permissions and assigned responsibilities.
                </p>
            </section>

            <hr>

            <section class="my-5">
                <h4 class="fw-bold mb-3">
                    <i class="bi bi-person-lock text-primary me-2"></i>
                    User Access
                </h4>

                <p class="text-muted">
                    Users are responsible for protecting their account
                    credentials and maintaining the confidentiality of
                    information accessed through the system.
                </p>

                <p class="text-muted mb-0">
                    Accounts must only be used by the authorised individual
                    to whom they are assigned.
                </p>
            </section>

            <hr>

            <section class="my-5">
                <h4 class="fw-bold mb-3">
                    <i class="bi bi-journal-check text-primary me-2"></i>
                    System Activity
                </h4>

                <p class="text-muted mb-0">
                    Certain activities within the system may be recorded for
                    security, accountability, operational, and administrative
                    purposes. Access to such records is restricted to
                    authorised personnel.
                </p>
            </section>

            <hr>

            <section class="my-5">
                <h4 class="fw-bold mb-3">
                    <i class="bi bi-exclamation-triangle text-primary me-2"></i>
                    Responsible Use
                </h4>

                <p class="text-muted">
                    Users must not attempt to access information, functions,
                    or areas of the system that they are not authorised to
                    access.
                </p>

                <p class="text-muted mb-0">
                    Any suspected security issue, unauthorised access, or
                    misuse of the system should be reported to the appropriate
                    system administrator.
                </p>
            </section>

            <hr>

            <section class="mt-5">
                <h4 class="fw-bold mb-3">
                    <i class="bi bi-shield-fill-check text-primary me-2"></i>
                    Commitment to Privacy
                </h4>

                <p class="text-muted mb-0">
                    Protecting the privacy and security of information is an
                    important part of maintaining a reliable and trusted
                    hospital management environment.
                </p>
            </section>

        </div>
    </div>

    <div class="text-center mt-4">
        <p class="text-muted small mb-0">
            This policy applies to the use of the Hospital Management System.
        </p>
    </div>

</div>