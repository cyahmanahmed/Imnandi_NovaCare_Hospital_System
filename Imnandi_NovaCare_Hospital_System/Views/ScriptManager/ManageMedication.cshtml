@using Imnandi_NovaCare_Hospital_System.Models
@model IEnumerable<Medication>

@{
    ViewData["Title"] = "Manage Medications";
    var currentStatus = ViewBag.CurrentStatus?.ToString() ?? "all";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-capsule"></i> Manage Medications</h3>
        <div>
            <a asp-controller="ScriptManager" asp-action="ScriptManagerDashboard" class="btn btn-secondary me-2">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
            <a asp-action="CreateMedication" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Add Medication
            </a>
        </div>
    </div>

    <div class="d-flex mb-3 flex-wrap">
        <a asp-action="ManageMedication" asp-route-status="all"
           class="btn @(currentStatus == "all" ? "btn-primary" : "btn-outline-secondary") me-2 mb-2">
            All Medications
        </a>
        <a asp-action="ManageMedication" asp-route-status="expiring"
           class="btn @(currentStatus == "expiring" ? "btn-warning" : "btn-outline-secondary") me-2 mb-2">
            Expiring Soon
        </a>
        <a asp-action="ManageMedication" asp-route-status="expired"
           class="btn @(currentStatus == "expired" ? "btn-danger" : "btn-outline-secondary") me-2 mb-2">
            Expired
        </a>
        <a asp-action="ManageMedication" asp-route-status="ok"
           class="btn @(currentStatus == "ok" ? "btn-success" : "btn-outline-secondary") mb-2">
            Good Stock
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No medications available. Click <strong>Add Medication</strong> to create one.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Dosage Form</th>
                        <th>Manufacturer</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                        <th>Report</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var med in Model)
                    {
                        <tr>
                            <td>@med.MedicationId</td>
                            <td>@med.MedicationName</td>
                            <td>@med.Description</td>
                            <td>@med.DosageForm</td>
                            <td>@med.Manufacturer</td>
                            <td class="text-center">
                                @if (med.ExpiryDate.HasValue)
                                {
                                    var expiryDate = med.ExpiryDate.Value;
                                    var isExpired = expiryDate < DateTime.Now;
                                    var isExpiringSoon = expiryDate >= DateTime.Now && expiryDate <= DateTime.Now.AddDays(30);

                                    <span class="@(isExpired ? "text-danger" : isExpiringSoon ? "text-warning" : "text-success")">
                                        @expiryDate.ToString("yyyy-MM-dd")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No expiry</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (med.ExpiryDate.HasValue)
                                {
                                    var expiryDate = med.ExpiryDate.Value;
                                    var isExpired = expiryDate < DateTime.Now;
                                    var isExpiringSoon = expiryDate >= DateTime.Now && expiryDate <= DateTime.Now.AddDays(30);

                                    if (isExpired)
                                    {
                                        <span class="badge bg-danger">EXPIRED</span>
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <span class="badge bg-warning text-dark">EXPIRING SOON</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">GOOD</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">NO EXPIRY</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="EditMedication" asp-route-id="@med.MedicationId" class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                @if (!med.IsDeleted)
                                {
                                    <form asp-action="DeleteMedication" asp-route-id="@med.MedicationId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="RestoreMedication" asp-route-id="@med.MedicationId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-arrow-counterclockwise"></i> Restore
                                        </button>
                                    </form>
                                }

                                @if (med.ExpiryDate.HasValue && med.ExpiryDate.Value <= DateTime.Now.AddDays(30))
                                {
                                    <form asp-controller="ScriptManager" asp-action="NotifyStockManager" method="post" class="d-inline ms-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="medicationId" value="@med.MedicationId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-bell-fill"></i> Notify Stock Manager
                                        </button>
                                    </form>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Reports" asp-action="MedicationFullReport" asp-route-medicationId="@med.MedicationId" class="btn btn-sm btn-info">
                                    <i class="bi bi-file-earmark-bar-graph"></i> Report
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}
