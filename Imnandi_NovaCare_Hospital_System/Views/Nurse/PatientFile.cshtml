 @model Patient

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/Nurse.css" rel="stylesheet" />
</head>

<div class="container-fluid mt-5 mb-5" style="margin-left:2.8rem;">
    <div class="card shadow-lg border-0 rounded-4">
        
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" 
             style="background: linear-gradient(90deg, #007bff, #00b4d8);">
            <h4 class="mb-0 fw-semibold">
                <i class="bi bi-person-vcard me-2"></i> Patient File
            </h4>
           
        </div>

        <div class="card-body bg-light">
            <div class="row g-4">

                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <h5 class="border-bottom pb-2 mb-3 text-primary fw-semibold">
                                <i class="bi bi-info-circle me-2"></i>Patient Information
                            </h5>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Full Name</label>
                                <input asp-for="FirstName" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Gender</label>
                                <input asp-for="Gender" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">ID Number</label>
                                <input asp-for="IdNumber" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Admitted Date</label>
                                <input asp-for="DateAdmitted" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <h5 class="border-bottom pb-2 mb-3 text-primary fw-semibold">
                                <i class="bi bi-building me-2"></i>Ward & Room Details
                            </h5>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Ward Name</label>
                                <input asp-for="Room.Ward.WardName" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Room Name</label>
                                <input asp-for="Room.RoomName" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Bed Number</label>
                                <input asp-for="Bed.BedNumber" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Attending Doctor</label>
                                <input asp-for="Doctor.FirstName" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body">
                            <h5 class="border-bottom pb-2 mb-3 text-primary fw-semibold">
                                <i class="bi bi-capsule me-2"></i>Current Medication
                            </h5>
                            <textarea asp-for="CurrentMedication" class="form-control" rows="5" readonly></textarea>
                        </div>
                    </div>
                </div>

                <div class="col-12 text-center mt-4">
                    <a asp-action="RecordVitalSign" asp-route-patientId="@Model.Id" asp-route-nurseId="@Model.NurseId" 
                       class="btn btn-outline-primary btn-lg me-2">
                        <i class="bi bi-heart-pulse me-1"></i> Record Vital Signs
                    </a>

                    <a asp-action="ViewHistoryVist" asp-route-patientId="@Model.Id" 
                       class="btn btn-outline-warning btn-lg me-2">
                        <i class="bi bi-clock-history me-1"></i> View History Visits
                    </a>

                    <a asp-action="Patients" asp-route-roomId="@Model.Room.RoomId"
                       class="btn btn-danger btn-lg">
                        <i class="bi bi-arrow-left-square me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}