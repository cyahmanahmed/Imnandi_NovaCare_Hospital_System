@model IEnumerable<Ward>

@{
    ViewData["Title"] = "Manage Wards";
}


<style>

    body {
        background: linear-gradient(135deg, #f6f9fc 0%, #e8f0fe 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
    }



    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }
        .page-header h3 {
            font-weight: 600;
            color: #007bff;
        }

    .ward-card {
        background: #ffffff;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
        transition: all .3s ease;
        position: relative;
        overflow: hidden;
        min-height: 300px;
    }

        .ward-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(180deg,#00b4d8,#0077b6);
        }





        .ward-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }




    .ward-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: linear-gradient(135deg,#007bff,#00b4d8);
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 2rem;
        margin: 0 auto 15px;
    }





    .ward-info h5 {
        font-weight: 600;
        color: #212529;
    }



    .ward-info p {
        color: #6c757d;
        font-size: .9rem;
        margin-bottom: .5rem;
    }




    .btn-view {
        border-radius: 30px;
        font-weight: 500;
        padding: .5rem 1.3rem;
        transition: .3s ease;
    }



        .btn-view:hover {
            background: #007bff;
            color: white;
        }




    .no-data {
        text-align: center;
        padding: 5rem 2rem;
        color: #6c757d;
    }

</style>





<div class="container py-5">

    <div class="mb-4">

        <a asp-action="NurseDashBoard"
           asp-controller="Nurse"
           class="btn btn-outline-primary px-4 py-2 shadow-sm"
           style="border-radius:50px;">


            <i class="bi bi-house-door-fill me-2"></i>

            Back to Dashboard


        </a>


    </div>

    <div class="page-header">


        <h3>

            <i class="bi bi-hospital-fill me-2"></i>

            Manage Wards


        </h3>


    </div>






    <div class="row g-4">


        @if (Model == null || !Model.Any())
        {


            <div class="col-12 no-data">


                <i class="bi bi-hospital"></i>


                <h5>
                    No Wards Found
                </h5>


                <p>
                    There are currently no wards available.
                </p>


            </div>


        }
        else
        {


            foreach (var ward in Model)
            {


                <div class="col-lg-4 col-md-6">


                    <div class="ward-card p-4 text-center">


                        <div class="ward-icon">


                            <i class="bi bi-hospital-fill"></i>


                        </div>




                        <div class="ward-info">


                            <h5>
                                @ward.WardName
                            </h5>



                            <p>

                                <i class="bi bi-geo-alt me-1"></i>

                                @ward.Location

                            </p>




                            <p>

                                <i class="bi bi-door-open me-1"></i>

                                Rooms:

                                <strong>
                                    @(ward.Rooms?.Count ?? 0)
                                </strong>

                            </p>





                            <p>

                                <i class="bi bi-person-badge me-1"></i>

                                Nurse Sister:

                                <strong>

                                    @(ward.NurseSister != null
                                    ? ward.NurseSister.FirstName + " " + ward.NurseSister.LastName
                                    : "Not Assigned")

                        </strong>

                            </p>


                        </div>






                        <div class="mt-3">


                            <a asp-action="Rooms"
                               asp-controller="Nurse"
                               asp-route-wardId="@ward.WardId"
                               class="btn btn-outline-primary btn-view">


                                <i class="bi bi-door-open me-1"></i>

                                View Rooms


                            </a>


                        </div>



                    </div>


                </div>


                }


        }


    </div>



</div>