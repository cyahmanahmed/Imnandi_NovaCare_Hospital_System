@model IEnumerable<Instruction>

@{
    ViewData["Title"] = "Doctor's Instructions";
}

<div class="row mt-4">
    <div class="col-12 mb-4">
        <a asp-controller="Nurse" asp-action="NurseDashBoard"
           class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
           style="border-radius: 80px;">
            <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
        </a>
    </div>
</div>



<h2 class="mb-4 text-center">@ViewData["Title"]</h2>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card border-primary text-dark">
                 <div class="text-center">
                    <p class="text-dark">#@item.InstructionId</p>
                    <p class=" text-muted mb-2">
                    <p><strong>Created:</strong> @item.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    
                 </div>
                <div class="card-body">
                    <h4 class="card-title text-primary">@item.Title</h4>
                   <div class="row" style="font-size:x-large">

                        <p><b>Description:</b> @item.Description</p>
                       
                   </div> 
                    
                   

                    <div class="d-flex justify-content-between align-items-center mt-3">

                        <div style="font-size:larger">
                            <p> <b>Patient:</b> @item.Patient.FirstName&nbsp;@item.Patient.LastName</p>
                            <p><b>Ward Info:</b> @item.Patient.Room.Ward.WardName</p>
                            <p> <b>Room Info:</b> @item.Patient.Room.RoomName</p>
                        </div>  
                        <div class="col">
                            <a asp-action="SeenInstruction" asp-route-instructionId="@item.InstructionId" class="btn btn-primary">Seen</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
