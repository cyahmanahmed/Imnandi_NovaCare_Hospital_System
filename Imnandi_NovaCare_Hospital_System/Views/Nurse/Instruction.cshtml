@model IEnumerable<Instruction>

@{
    ViewData["Title"] = "Doctor Instructions";
}

<style>
    body {
        background: linear-gradient(135deg,#f6f9fc 0%,#e8f0fe 100%);
        font-family: 'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
        color: #333;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .page-header h3 {
        color: #007bff;
        font-weight: 600;
    }

    .instruction-card {
        background: white;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
        position: relative;
        overflow: hidden;
        transition: .3s ease;
    }

    .instruction-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 6px;
        background: linear-gradient(180deg,#007bff,#00b4d8);
    }

    .instruction-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,.15);
    }

    .instruction-card.read {
        opacity: .75;
    }

    .instruction-card.read::before {
        background: #adb5bd;
    }

    .instruction-title {
        font-weight: 600;
        color: #212529;
    }

    .info-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 12px;
        margin-top: 15px;
    }

    .info-row {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        font-size: .9rem;
    }

    .info-row:last-child {
        margin-bottom: 0;
    }

    .info-row i {
        color: #007bff;
        width: 25px;
    }

    .description {
        background: #f8fbff;
        padding: 12px;
        border-radius: 10px;
        color: #555;
        margin-top: 15px;
    }

    .status-badge {
        border-radius: 20px;
        padding: .35rem .8rem;
        font-size: .8rem;
        font-weight: 600;
    }

    .active-status {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .read-status {
        background: #e9ecef;
        color: #6c757d;
    }

    .btn-action {
        border-radius: 30px;
        padding: .5rem 1.3rem;
        font-weight: 500;
    }

    .no-data {
        text-align: center;
        padding: 5rem 2rem;
        color: #6c757d;
    }

    .no-data i {
        font-size: 3rem;
    }
</style>

<div class="container py-5">


    <div class="mb-4">
        <a asp-action="NurseDashBoard"
           asp-controller="Nurse"
           class="btn btn-outline-primary px-4 py-2 shadow-sm"
           style="border-radius:50px;">


            <i class="bi bi-house-door-fill me-2"></i>

            Back to Dashboard
        </a>
    </div>

    <div class="page-header">
        <h3>
            <i class="bi bi-clipboard2-pulse me-2"></i>

            Doctor Instructions
        </h3>
    </div>


    @if (Model == null || !Model.Any())
    {

        <div class="no-data">

            <i class="bi bi-file-earmark-medical"></i>

            <h5 class="mt-3">
                No Doctor Instructions Found
            </h5>


            <p>
                There are currently no patient instructions available.
            </p>

        </div>

    }

    else
    {
        <div class="row g-4">
            @foreach (var instruction in Model)
            {


                <div class="col-lg-4 col-md-6">


                    <div class="instruction-card p-4 @(instruction.isActive ? "" : "read")">



                        <div class="d-flex justify-content-between align-items-start mb-3">


                            <h5 class="instruction-title mb-0">

                                @instruction.Title

                            </h5>



                            @if (instruction.isActive)
                            {

                                <span class="status-badge active-status">

                                    Active

                                </span>

                            }
                            else
                            {

                                <span class="status-badge read-status">

                                    Read

                                </span>

                            }


                        </div>

                        <small class="text-muted">

                            <i class="bi bi-calendar3 me-1"></i>

                            @instruction.CreatedAt.ToString("dd MMM yyyy")

                        </small>

                        <div class="info-section">


                            <div class="info-row">

                                <i class="bi bi-person-badge"></i>

                                <span>

                                    <strong>Doctor:</strong><br />

                                    @instruction.Doctor.FirstName
                                    @instruction.Doctor.LastName

                                </span>


                            </div>

                            <div class="info-row">

                                <i class="bi bi-person-vcard"></i>


                                <span>

                                    <strong>Patient:</strong><br />

                                    @instruction.Patient.FirstName
                                    @instruction.Patient.LastName

                                </span>


                            </div>

                        </div>

                        <div class="description">


                            <strong>
                                Medical Instruction
                            </strong>


                            <p class="mb-0 mt-2">

                                @instruction.Description

                            </p>


                        </div>

                        @if (instruction.isActive)
                        {

                            <div class="mt-3">


                                <form asp-action="SeenInstruction"
                                      asp-route-instructionId="@instruction.InstructionId"
                                      method="post">


                                    <button type="submit"
                                            class="btn btn-outline-success btn-action w-100">


                                        <i class="bi bi-check-circle me-1"></i>

                                        Mark as Read
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    }
</div>