@model IEnumerable<Room>

@{
    ViewData["Title"] = "Manage Rooms";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />


<style>

    body {
        background: linear-gradient(135deg, #f6f9fc 0%, #e8f0fe 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }


    .page-header h3 {
        font-weight: 600;
        color: #007bff;
    }

    .room-card {
        background: #ffffff;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
        transition: all .3s ease;
        position: relative;
        overflow: hidden;
    }



    .room-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 6px;
        height: 100%;
        background: linear-gradient(180deg,#00b4d8,#0077b6);
    }



    .room-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,.15);
    }

    .room-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: linear-gradient(135deg,#007bff,#00b4d8);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        margin: 0 auto 15px;
    }




    .room-info h5 {
        font-weight: 600;
        color: #212529;
    }




    .room-info p {
        font-size: .9rem;
        color: #6c757d;
        margin-bottom: .4rem;
    }




    .status-badge {
        padding: .35rem .8rem;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 600;
    }


    .available {
        background: #d1fae5;
        color: #047857;
    }


    .occupied {
        background: #fee2e2;
        color: #b91c1c;
    }




    .btn-view {
        border-radius: 30px;
        font-weight: 500;
        padding: .5rem 1.2rem;
        transition: .3s ease;
    }



        .btn-view:hover {
            background: #007bff;
            color: white;
        }




    .no-data {
        text-align: center;
        padding: 5rem 2rem;
        color: #6c757d;
    }


        .no-data i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

</style>





<div class="container py-5">

    <div class="mb-4">

        <a asp-action="Wards" asp-controller="Nurse" class="btn btn-outline-primary px-4 py-2 shadow-sm" style="border-radius:50px;">
            Back to Wards
        </a>

    </div>

    <div class="page-header">

        <h3>

            <i class="bi bi-door-open-fill me-2"></i>

            Manage Rooms

        </h3>


    </div>


    <div class="row g-4">


        @if (Model == null || !Model.Any())
        {


            <div class="col-12 no-data">

                <i class="bi bi-door-closed"></i>

                <h5>No Rooms Found</h5>

                <p>
                    There are currently no rooms available in this ward.
                </p>

            </div>


        }

        else
        {


            foreach (var room in Model)
            {


                var isAvailable = !room.IsDeleted &&
                room.NoOccupiedBed < room.RoomCapacity;



                <div class="col-lg-3 col-md-4 col-sm-6">


                    <div class="room-card p-4 text-center">



                        <div class="room-icon">

                            <i class="bi bi-door-open-fill"></i>

                        </div>




                        <div class="room-info">


                            <h5>
                                Room @room.RoomNumber
                            </h5>



                            <p>

                                <i class="bi bi-hospital me-1"></i>

                                Capacity:
                                <strong>
                                    @room.RoomCapacity beds
                                </strong>

                            </p>




                            <p>

                                <i class="bi bi-bed me-1"></i>

                                Available:
                                <strong>
                                    @room.AvailableBeds
                                </strong>

                            </p>




                            <p>

                                <i class="bi bi-people me-1"></i>

                                Occupied:
                                <strong>
                                    @room.NoOccupiedBed
                                </strong>

                            </p>





                            @if (isAvailable)
                            {

                                <span class="status-badge available">

                                    Available

                                </span>

                            }
                            else
                            {

                                <span class="status-badge occupied">

                                    Occupied

                                </span>

                            }



                        </div>






                        <div class="mt-3">


                            <a asp-action="Patients"
                               asp-controller="Nurse"
                               asp-route-roomId="@room.RoomId"
                               class="btn btn-outline-primary btn-view">


                                <i class="bi bi-people-fill me-1"></i>

                                View Patients


                            </a>


                        </div>



                    </div>



                </div>


            }


        }


    </div>



</div>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>