@model CreatePatientViewModel
@{
    ViewData["Title"] = "Edit Patient";
}

<h2>Edit Patient</h2>

<form asp-action="EditPatient" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdNumber"></label>
        <input asp-for="IdNumber" class="form-control" />
        <span asp-validation-for="IdNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" class="form-control" type="date" />
    </div>

    <div class="form-group">
        <label asp-for="Gender"></label>
        <input asp-for="Gender" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="EmergencyContact"></label>
        <input asp-for="EmergencyContact" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Allergies">Allergies (comma separated)</label>
        <input asp-for="Allergies" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MedicalHistoryDescription"></label>
        <textarea asp-for="MedicalHistoryDescription" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="BankName"></label>
        <input asp-for="BankName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="BankAccountNumber"></label>
        <input asp-for="BankAccountNumber" class="form-control" />
    </div>

    <div class="form-group mt-3">
        <label class="form-label">Is Insured?</label>

        <div class="form-check">
            <input class="form-check-input"
                   type="radio"
                   asp-for="IsInsured"
                   value="true"
                   id="insuredYes" />
            <label class="form-check-label" for="insuredYes">
                Yes
            </label>
        </div>

        <div class="form-check">
            <input class="form-check-input"
                   type="radio"
                   asp-for="IsInsured"
                   value="false"
                   id="insuredNo" />
            <label class="form-check-label" for="insuredNo">
                No
            </label>
        </div>
    </div>

    <div id="insurancePanel" class="card border-primary shadow-sm mt-3 mb-3" style="display:none;">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0">Insurance Details</h6>
        </div>

        <div class="card-body">

            <div class="form-group mb-3">
                <label asp-for="InsuranceProvider"></label>
                <input asp-for="InsuranceProvider" class="form-control" />
                <span asp-validation-for="InsuranceProvider" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PolicyNumber"></label>
                <input asp-for="PolicyNumber" class="form-control" />
                <span asp-validation-for="PolicyNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MedicalAidPlan"></label>
                <input asp-for="MedicalAidPlan" class="form-control" />
                <span asp-validation-for="MedicalAidPlan" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MainMemberName"></label>
                <input asp-for="MainMemberName" class="form-control" />
                <span asp-validation-for="MainMemberName" class="text-danger"></span>
            </div>

        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="ManagePatients" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        function toggleInsurancePanel() {

            const insured = document.getElementById("insuredYes").checked;

            document.getElementById("insurancePanel").style.display =
                insured ? "block" : "none";
        }

        document.addEventListener("DOMContentLoaded", function () {

            toggleInsurancePanel();

            document.getElementById("insuredYes")
                .addEventListener("change", toggleInsurancePanel);

            document.getElementById("insuredNo")
                .addEventListener("change", toggleInsurancePanel);
        });
    </script>

}
