@model IEnumerable<Patient>
@{
    ViewData["Title"] = "Manage Patients";
    var searchString = Context.Request.Query["searchString"].ToString();
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <a asp-controller="WardAdmin" asp-action="WardAdminDashboard"
               class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
               style="border-radius: 80px;">
                <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="header-title">Manage Patients</h1>
            <p class="sub-title">View and manage patient records across the hospital.</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="WardAdmin" asp-action="CreatePatient"
               class="btn btn-lg btn-success shadow-sm d-flex align-items-center justify-content-center">
                <i class="bi bi-person-plus-fill me-2"></i> Add Patient
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12 col-lg-14">
            <form asp-action="ManagePatients" method="get" class="input-group">
                <input type="text"
                       name="searchString"
                       class="form-control form-control-lg"
                       placeholder="Search by name..."
                       value="@searchString" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i> Search
                </button>
                <a asp-action="ManagePatients" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i> Clear
                </a>
            </form>
        </div>
    </div>
    <div class="row">
        <div class="col-12 table-responsive">
            @if (!Model.Any())
            {
                <div class="card bg-light border-0">
                    <div class="card-body text-center empty-state">
                        <i class="fas fa-procedures fa-3x text-muted mb-3"></i>
                        <h4>No patients found</h4>
                        <p class="mb-0">Use the <strong>Add Patient</strong> button to add new records.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row mb-4">
                    <div class="col text-end">
                        <a asp-action="ManageAllPatients"
                           class="btn btn-outline-secondary btn-sm shadow-sm d-flex align-items-center">
                            <i class="bi bi-trash2-fill me-1"></i> View Patient Movement
                        </a>
                    </div>
                </div>
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Patient List</h5>
                        <small>@Model.Count() patients</small>
                    </div>
                    <div class="">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Gender</th>
                                    <th>Date Admitted</th>
                                    <th>Insured</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var patient in Model)
                                {
                                    <tr class="@(patient.IsDeleted ? "table-danger" : "")">
                                        <td>@patient.FirstName</td>
                                        <td>@patient.LastName</td>
                                        <td>@patient.Gender</td>
                                        <td>@patient.DateAdmitted.ToShortDateString()</td>
                                        <td>
                                            @if (patient.IsInsured)
                                            {
                                                <span class="badge badge-insured badge-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group" aria-label="Patient Actions">
                                                <a class="btn btn-outline-primary btn-sm me-1" asp-action="EditPatient" asp-route-id="@patient.Id">
                                                    <i class="bi bi-pencil-fill me-1"></i> Edit
                                                </a>
                                                @if (!patient.IsDeleted && !patient.IsDischarged)
                                                {
                                                    <a class="btn btn-outline-success btn-sm me-1" asp-action="ManagePatientMovement" asp-route-patientId="@patient.Id">
                                                        <i class="bi bi-arrow-right-circle me-1"></i> Move
                                                    </a>
                                                }
                                                @if (patient.IsDischarged && !patient.IsDeleted)
                                                {
                                                    <a class="btn btn-warning btn-sm me-1" asp-action="ReadmitPatient" asp-route-patientId="@patient.Id">
                                                        <i class="bi bi-arrow-clockwise me-1"></i> Readmit
                                                    </a>
                                                }

                                                @if (!patient.IsDeleted)
                                                {
                                                    <form asp-action="DeletePatient" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@patient.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                                            <i class="bi bi-trash-fill me-1"></i> Delete
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row mb-4">
        <div class="col text-end">
            <a asp-action="DeletedPatients"
               class="btn btn-outline-danger btn-sm shadow-sm d-flex align-items-center">
                <i class="bi bi-trash2-fill me-1"></i> View Deleted Patients
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .header-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1e40af;
    }

    .sub-title {
        color: #6b7280;
        font-size: 1rem;
    }

    .badge-insured {
        font-size: 0.85em;
        padding: 0.4em 0.8em;
        border-radius: 50px;
        font-weight: 500;
        background-color: #dcfce7;
        color: #10b981;
    }

    .empty-state {
        padding: 4rem 1rem;
        color: #6b7280;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #e5e7eb;
    }

    .input-group .btn {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-weight: 500;
    }

    .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .input-group .btn:first-of-type {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .input-group .btn-outline-secondary {
        margin-left: 0.3rem;
    }
</style>
