@using Imnandi_NovaCare_Hospital_System.Models
@model List<ManageWardViewModel>

@{
    ViewData["Title"] = "Manage Wards";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-hospital text-primary me-2"></i>
                Ward Management
            </h2>
            <p class="text-muted mb-0">
                Assign Nurse Sisters and monitor nursing staff across hospital wards.
            </p>
        </div>

        <a asp-controller="WardAdmin"
           asp-action="WardAdminDashboard"
           class="btn btn-outline-primary rounded-pill shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i>
            Dashboard
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-hospital display-3 text-muted"></i>
            <h4 class="mt-3 text-muted">No wards available</h4>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var ward in Model)
            {
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-header bg-white border-0 rounded-top-4 pt-4 pb-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h4 class="fw-bold mb-1">
                                        @ward.WardName
                                    </h4>

                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        @ward.Location
                                    </small>
                                </div>

                                <span class="badge bg-primary px-3 py-2">
                                    @ward.Capacity Beds
                                </span>

                            </div>

                        </div>

                        <div class="card-body">

                            <div class="border rounded-3 p-3 mb-4 bg-light">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <small class="text-muted text-uppercase">
                                            Nurse Sister
                                        </small>

                                        <div class="fw-semibold fs-5">

                                            @if (ward.NurseSisterId.HasValue)
                                            {
                                                <span class="text-success">
                                                    <i class="bi bi-person-check-fill me-1"></i>
                                                    @ward.NurseSisterName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">
                                                    <i class="bi bi-person-dash me-1"></i>
                                                    Unassigned
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                           
                            <form asp-action="AssignNurseSister" method="post" class="mb-3">

                                <input type="hidden"
                                       name="WardId"
                                       value="@ward.WardId" />

                                <label class="form-label fw-semibold">
                                    Assign Nurse Sister
                                </label>

                                <div class="input-group">

                                    <select name="NurseSisterId"
                                            class="form-select"
                                            required>

                                        <option value="">
                                            Select Nurse Sister
                                        </option>

                                        @foreach (var ns in ward.NurseSisters)
                                        {
                                            <option value="@ns.Value"
                                                    selected="@(ward.NurseSisterId?.ToString()==ns.Value)">
                                                @ns.Text
                                            </option>
                                        }

                                    </select>

                                    <button class="btn btn-success"
                                            type="submit">

                                        <i class="bi bi-check-lg me-1"></i>
                                        Assign

                                    </button>

                                </div>

                            </form>

                            @if (ward.NurseSisterId.HasValue)
                            {
                                <form asp-action="UnassignNurseSister"
                                      method="post"
                                      class="mb-4">

                                    <input type="hidden"
                                           name="WardId"
                                           value="@ward.WardId" />

                                    <button class="btn btn-outline-danger w-100"
                                            onclick="return confirm('Remove Nurse Sister from @ward.WardName?')">

                                        <i class="bi bi-person-x me-2"></i>

                                        Unassign Nurse Sister

                                    </button>

                                </form>
                            }


                            <div class="border-top pt-3">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <h6 class="fw-bold mb-0">
                                        <i class="bi bi-people-fill text-primary me-2"></i>
                                        Assigned Nurses
                                    </h6>

                                    <span class="badge bg-light text-dark">
                                        @(ward.Nurses?.Count() ?? 0)
                                    </span>

                                </div>

                                @if (ward.Nurses != null && ward.Nurses.Any())
                                {
                                    foreach (var nurse in ward.Nurses)
                                    {
                                        <div class="d-flex justify-content-between align-items-center border rounded-3 px-3 py-2 mb-2">

                                            <div>

                                                <div class="fw-semibold">
                                                    <i class="bi bi-person-fill text-primary me-2"></i>
                                                    @nurse.FirstName @nurse.LastName
                                                </div>

                                                <small class="text-muted">
                                                    @nurse.Employee?.Email
                                                </small>

                                            </div>

                                            <span class="badge bg-success-subtle text-success border">
                                                Assigned
                                            </span>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-3 text-muted">

                                        <i class="bi bi-person-x fs-3"></i>

                                        <div class="mt-2">
                                            No nurses assigned to this ward.
                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>