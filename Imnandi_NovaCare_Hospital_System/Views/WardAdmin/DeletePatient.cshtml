@model Patient
@{
    ViewData["Title"] = "Delete Patient";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<div class="container mt-5">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Confirm Patient Deletion</h4>
            <i class="bi bi-exclamation-triangle-fill fs-3"></i>
        </div>
        <div class="card-body">
            <p class="mb-4">
                Are you sure you want to delete this patient? 
                <strong>This is a soft delete.</strong> Patient data will remain in the system but will be marked as deleted.
            </p>
            
            <ul class="list-group mb-4">
                <li class="list-group-item"><strong>Name:</strong> @Model.FirstName @Model.LastName</li>
                <li class="list-group-item"><strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")</li>
                <li class="list-group-item"><strong>Gender:</strong> @Model.Gender</li>
            </ul>

            <div class="container mt-3">
                @if (TempData["TempError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["TempError"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["TempSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["TempSuccess"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>


            <div class="d-flex justify-content-between">
                <a asp-action="ManagePatients" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left me-1"></i> Cancel
                </a>
                <form asp-action="DeletePatient" method="post" id="deletePatientForm">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#deletePatientForm').on('submit', function (e) {
                e.preventDefault();
                let confirmed = confirm("Are you absolutely sure you want to delete this patient? This action is reversible only via soft undelete.");
                if (confirmed) {
                    this.submit();
                }
            });
        });
    </script>
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-header i {
        color: #fff;
    }

    .list-group-item {
        font-size: 1rem;
    }

    .btn-lg {
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
    }
</style>
