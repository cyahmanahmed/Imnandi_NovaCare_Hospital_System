@model List<Doctor>

@{
    ViewData["Title"] = "Manage Doctors";

    var totalDoctors = Model.Count;
    var availableDoctors = Model.Count(d => d.IsAvail);
    var busyDoctors = totalDoctors - availableDoctors;
}

<div class="container-fluid">

    <div class="card border-0 shadow rounded-4 mb-4 overflow-hidden">

        <div class="card-header bg-primary text-white p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="mb-1">
                        <i class="bi bi-heart-pulse-fill me-2"></i>
                        Manage Doctors
                    </h2>

                    <p class="mb-0 opacity-75">
                        View doctor information, availability and department details.
                    </p>

                </div>

                <a asp-action="WardAdminDashboard"
                   asp-controller="WardAdmin"
                   class="btn btn-light">

                    <i class="bi bi-arrow-left-circle me-1"></i>

                    Dashboard

                </a>

            </div>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">Total Doctors</small>

                            <h2 class="fw-bold">@totalDoctors</h2>

                        </div>

                        <i class="bi bi-people-fill text-primary fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">Available</small>

                            <h2 class="fw-bold text-success">@availableDoctors</h2>

                        </div>

                        <i class="bi bi-check-circle-fill text-success fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">Busy</small>

                            <h2 class="fw-bold text-danger">@busyDoctors</h2>

                        </div>

                        <i class="bi bi-x-circle-fill text-danger fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow rounded-4 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-lg-5">

                    <label class="form-label fw-semibold">
                        Search Doctor
                    </label>

                    <input type="text"
                           id="searchDoctor"
                           class="form-control"
                           placeholder="Search doctor by name..." />

                </div>

                <div class="col-lg-4">

                    <label class="form-label fw-semibold">
                        Department
                    </label>

                    <select id="departmentFilter" class="form-select">

                        <option value="">All Departments</option>

                        <option>General Medicine</option>
                        <option>Cardiology</option>
                        <option>Oncology</option>
                        <option>Surgery</option>
                        <option>Orthopedics</option>
                        <option>Pediatrics</option>
                        <option>Radiology</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label fw-semibold">
                        Availability
                    </label>

                    <select id="statusFilter" class="form-select">

                        <option value="">All</option>
                        <option value="Available">Available</option>
                        <option value="Busy">Busy</option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow rounded-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-person-vcard-fill text-primary me-2"></i>

                Doctors

            </h5>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0" id="doctorTable">

                <thead>

                    <tr>

                        <th>Doctor</th>

                        <th>Department</th>

                        <th>Job Title</th>

                        <th>Email</th>

                        <th>Phone</th>

                        <th>Status</th>

                        <th class="text-center">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var doctor in Model)
                        {
                            <tr>

                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="doctor-icon me-3">

                                            <i class="bi bi-person-fill"></i>

                                        </div>

                                        <div>

                                            <strong>

                                                Dr. @doctor.FirstName @doctor.LastName

                                            </strong>

                                        </div>

                                    </div>

                                </td>

                                <td>@doctor.Department</td>

                                <td>@doctor.Employee?.JobTitle</td>

                                <td>@doctor.Employee?.Email</td>

                                <td>@doctor.Employee?.PhoneNumber</td>

                                <td>

                                    @if (doctor.IsAvail)
                                    {
                                        <span class="badge rounded-pill bg-success px-3 py-2">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger px-3 py-2">
                                            Busy
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="DoctorDetails"
                                       asp-route-id="@doctor.DoctorId"
                                       class="btn btn-primary btn-sm rounded-pill">

                                        <i class="bi bi-eye"></i>

                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {

                        <tr>

                            <td colspan="7" class="text-center py-5">

                                <i class="bi bi-person-x display-4 text-muted"></i>

                                <h5 class="mt-3">

                                    No Doctors Found

                                </h5>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const search = document.getElementById("searchDoctor");
            const department = document.getElementById("departmentFilter");
            const status = document.getElementById("statusFilter");

            function filterDoctors() {

                const rows = document.querySelectorAll("#doctorTable tbody tr");

                rows.forEach(row => {

                    if(row.children.length < 7)
                        return;

                    const doctor = row.cells[0].innerText.toLowerCase();
                    const dept = row.cells[1].innerText;
                    const stat = row.cells[5].innerText.trim();

                    const matchSearch =
                        doctor.includes(search.value.toLowerCase());

                    const matchDept =
                        department.value === "" || dept === department.value;

                    const matchStatus =
                        status.value === "" || stat === status.value;

                    row.style.display =
                        (matchSearch && matchDept && matchStatus)
                        ? ""
                        : "none";

                });

            }

            search.addEventListener("keyup", filterDoctors);
            department.addEventListener("change", filterDoctors);
            status.addEventListener("change", filterDoctors);

        });

    </script>

}

<style>

    thead {
        background: #0d6efd;
        color: white;
    }

        thead th {
            position: sticky;
            top: 0;
        }

    .table tbody tr:hover {
        background: #f8fbff;
    }

    .doctor-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #eaf4ff;
        color: #0d6efd;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
    }

    .card {
        border-radius: 18px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
    }

    .btn {
        border-radius: 10px;
    }

</style>