@model IEnumerable<Patient>

@{
    ViewData["Title"] = "Deleted Patients";
    var searchString = Context.Request.Query["searchString"].ToString();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col-12">
            <a asp-action="ManagePatients"
               class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center shadow-sm"
               style="border-radius: 80px;">
                <i class="bi bi-house-door-fill me-2"></i> Manage Patients
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="header-title">Deleted Patients</h1>
            <p class="sub-title">View all patients who have been soft-deleted. Restore if necessary.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12 col-lg-12">
            <form asp-action="DeletedPatients" method="get" class="input-group">
                <input type="text"
                       name="searchString"
                       class="form-control form-control-lg"
                       placeholder="Search deleted patients..."
                       value="@searchString" />
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a href="@Url.Action("DeletedPatients")" class="btn btn-outline-secondary">Clear</a>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12 table-responsive">
            @if (!Model.Any())
            {
                <div class="card bg-light border-0">
                    <div class="card-body text-center empty-state">
                        <i class="fas fa-user-slash fa-3x text-muted mb-3"></i>
                        <h4>No deleted patients found</h4>
                        <p class="mb-0">All patients are currently active.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Deleted Patient List</h5>
                        <small>@Model.Count() patients</small>
                    </div>
                    <div class="">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>DOB</th>
                                    <th>Gender</th>
                                    <th>Bank</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var patient in Model)
                                {
                                    <tr>
                                        <td><strong>@patient.FirstName</strong> @patient.LastName</td>
                                        <td>@patient.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                        <td>@patient.Gender</td>
                                        <td>@patient.BankName</td>
                                        <td class="text-center">
                                            <form asp-action="RestorePatient" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@patient.Id" />
                                                <button type="submit" class="btn btn-outline-success btn-sm">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .header-title {
        font-size: 2rem;
        font-weight: 700;
        color: #dc3545;
    }

    .sub-title {
        color: #6b7280;
        font-size: 1rem;
    }

    .empty-state {
        padding: 4rem 1rem;
        color: #6b7280;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #e5e7eb;
    }

    .empty-state {
        padding: 4rem 1rem;
        color: #6b7280;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: #e5e7eb;
        }

    .input-group .btn {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-weight: 500;
    }

    .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .input-group .btn:first-of-type {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .input-group .btn-outline-secondary {
        margin-left: 0.3rem;
    }
</style>
