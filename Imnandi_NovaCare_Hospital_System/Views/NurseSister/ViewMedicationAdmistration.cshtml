@model IEnumerable<MedicationAdministration>

@{
    ViewData["Title"] = "Medication Schedule";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Nurse Sister</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link href="~/css/Nurse.css" rel="stylesheet" />

    <style>

        body {
            background: #f5f7fb;
        }

        .main {
            margin-left: 250px;
            padding: 30px;
            min-height: 100vh;
        }

        .page-header {
            background: #ffffff;
            border-radius: 16px;
            padding: 25px 30px;
            margin-bottom: 25px;
            border: 1px solid #e9edf3;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .page-header h2 {
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 5px;
        }

        .page-header p {
            color: #6b7280;
            margin-bottom: 0;
        }

        .header-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef4ff;
            color: #0d6efd;
            font-size: 24px;
        }

        .summary-card {
            background: #ffffff;
            border: 1px solid #e9edf3;
            border-radius: 14px;
            padding: 20px;
            height: 100%;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .summary-label {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 4px;
        }

        .summary-number {
            font-size: 25px;
            font-weight: 700;
            color: #1f2937;
        }

        .medication-card {
            background: #ffffff;
            border: 1px solid #e9edf3;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .medication-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid #edf0f4;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .medication-card-header h5 {
            margin: 0;
            font-weight: 700;
            color: #1f2937;
        }

        .medication-card-header span {
            color: #6b7280;
            font-size: 14px;
        }

        .medication-table {
            margin-bottom: 0;
        }

        .medication-table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 15px 18px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .medication-table tbody td {
            padding: 17px 18px;
            color: #374151;
            border-bottom: 1px solid #f0f2f5;
            vertical-align: middle;
        }

        .medication-table tbody tr:last-child td {
            border-bottom: none;
        }

        .medication-table tbody tr {
            transition: background .2s ease;
        }

        .medication-table tbody tr:hover {
            background: #f8fafc;
        }

        .patient-name {
            font-weight: 600;
            color: #1f2937;
        }

        .patient-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eef4ff;
            color: #0d6efd;
            margin-right: 9px;
        }

        .location-item {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #4b5563;
        }

        .location-item i {
            color: #64748b;
        }

        .medication-name {
            font-weight: 600;
            color: #1f2937;
        }

        .medication-icon {
            color: #198754;
            margin-right: 7px;
        }

        .level-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 10px;
            border-radius: 8px;
            background: #fff4e5;
            color: #b45309;
            font-size: 12px;
            font-weight: 700;
        }

        .seen-btn {
            border-radius: 8px;
            padding: 7px 12px;
            font-size: 13px;
            font-weight: 600;
        }

        .empty-state {
            padding: 70px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            border-radius: 18px;
            background: #f1f5f9;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .empty-state h4 {
            font-weight: 700;
            color: #374151;
        }

        .empty-state p {
            color: #6b7280;
            margin-bottom: 0;
        }

        {
            margin-left: 0;
            padding: 20px;
        }

        .medication-table {
            min-width: 950px;
        }

        }
    </style>
</head>

<body>

    <div class="main">

        <div class="page-header">

            <div class="d-flex align-items-center">

                <div class="header-icon me-3">
                    <i class="bi bi-capsule-pill"></i>
                </div>

                <div>
                    <h2>Medication Schedule</h2>

                    <p>
                        Review and monitor medication schedules for patients
                        within your assigned wards.
                    </p>
                </div>

            </div>

        </div>

        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="d-flex align-items-center">

                        <div class="summary-icon bg-primary bg-opacity-10 text-primary me-3">
                            <i class="bi bi-capsule-pill"></i>
                        </div>

                        <div>

                            <div class="summary-label">
                                Pending Medications
                            </div>

                            <div class="summary-number">
                                @Model.Count()
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="summary-card">

                    <div class="d-flex align-items-center">

                        <div class="summary-icon bg-warning bg-opacity-10 text-warning me-3">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div>

                            <div class="summary-label">
                                Requiring Attention
                            </div>

                            <div class="summary-number">
                                @Model.Count()
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="summary-card">

                    <div class="d-flex align-items-center">

                        <div class="summary-icon bg-success bg-opacity-10 text-success me-3">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <div class="summary-label">
                                Ward Monitoring
                            </div>

                            <div class="summary-number">
                                Active
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="medication-card">

            <div class="medication-card-header">

                <div>

                    <h5>
                        <i class="bi bi-clipboard2-pulse me-2 text-primary"></i>
                        Medication Administration
                    </h5>

                    <span>
                        Medication schedules requiring your review
                    </span>

                </div>

                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                    @Model.Count() Pending
                </span>

            </div>


            @if (!Model.Any())
            {

                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <h4>No Pending Medication Schedules</h4>

                    <p>
                        There are currently no medication schedules requiring your attention.
                    </p>

                </div>

            }
            else
            {

                <div class="table-responsive">

                    <table class="table medication-table">

                        <thead>

                            <tr>

                                <th>
                                    <i class="bi bi-person me-1"></i>
                                    Patient
                                </th>

                                <th>
                                    <i class="bi bi-hospital me-1"></i>
                                    Ward
                                </th>

                                <th>
                                    <i class="bi bi-door-open me-1"></i>
                                    Room
                                </th>

                                <th>
                                    <i class="bi bi-bed me-1"></i>
                                    Bed
                                </th>

                                <th>
                                    <i class="bi bi-bar-chart me-1"></i>
                                    Level
                                </th>

                                <th>
                                    <i class="bi bi-capsule me-1"></i>
                                    Medication
                                </th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {

                                <tr>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="patient-icon">
                                                <i class="bi bi-person-fill"></i>
                                            </div>

                                            <div>

                                                <div class="patient-name">
                                                    @item.Patient.FirstName @item.Patient.LastName
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <div class="location-item">

                                            <i class="bi bi-building"></i>

                                            @item.Patient.Room.Ward.WardName

                                        </div>

                                    </td>

                                    <td>

                                        <div class="location-item">

                                            <i class="bi bi-door-open"></i>

                                            @item.Patient.Room.RoomName

                                        </div>

                                    </td>

                                    <td>

                                        <div class="location-item">

                                            <i class="bi bi-bed"></i>

                                            @item.Patient.Bed.BedNumber

                                        </div>

                                    </td>

                                    <td>

                                        <span class="level-badge">

                                            <i class="bi bi-shield-exclamation me-1"></i>

                                            Level @item.Prescription.Level

                                        </span>

                                    </td>

                                    <td>

                                        <span class="medication-name">

                                            <i class="bi bi-capsule-pill medication-icon"></i>

                                            @item.Medication.MedicationName

                                        </span>

                                    </td>

                                    <td class="text-end">

                                        <form asp-action="SeenMedicationSchedule"
                                              asp-controller="NurseSister"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="MedicationAdministrationId"
                                                   value="@item.MedicationAdministrationId" />

                                            <button type="submit"
                                                    class="btn btn-outline-success seen-btn"
                                                    onclick="return confirm('Mark this medication schedule as reviewed?');">

                                                <i class="bi bi-check2-circle me-1"></i>
                                                Mark Reviewed

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const buttons = document.querySelectorAll(".seen-btn");

            buttons.forEach(button => {

                button.addEventListener("click", function () {

                    if (this.closest("form").checkValidity()) {

                        this.innerHTML =
                            '<span class="spinner-border spinner-border-sm me-2"></span>Updating...';

                        this.disabled = true;

                    }

                });

            });

        });

    </script>

</body>
</html>