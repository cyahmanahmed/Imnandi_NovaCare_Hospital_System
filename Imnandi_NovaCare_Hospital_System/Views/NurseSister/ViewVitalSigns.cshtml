@model IEnumerable<VitalSign>

@{
    ViewData["Title"] = "Patient Vital Signs";

    var vitalSigns = Model?.ToList()
        ?? new List<VitalSign>();

    var firstRecord = vitalSigns.FirstOrDefault();

    var patientName = firstRecord?.Patient != null
        ? $"{firstRecord.Patient.FirstName} {firstRecord.Patient.LastName}"
        : "Patient";

    var latestRecord = vitalSigns
        .OrderByDescending(v => v.RecordedAt)
        .FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Nurse Sister</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link href="~/css/Nurse.css" rel="stylesheet" />

    <style>

        body {
            background: #f5f7fb;
        }

        .main {
            margin-left: 250px;
            padding: 30px;
            min-height: 100vh;
        }

        .page-header {
            background: #ffffff;
            border: 1px solid #e9edf3;
            border-radius: 16px;
            padding: 24px 28px;
            margin-bottom: 24px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .header-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: #eef4ff;
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .page-header h2 {
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 4px;
        }

        .page-header p {
            color: #6b7280;
            margin-bottom: 0;
        }

        .back-button {
            border-radius: 9px;
            font-weight: 600;
            padding: 9px 15px;
            white-space: nowrap;
        }

        .summary-card {
            background: #ffffff;
            border: 1px solid #e9edf3;
            border-radius: 14px;
            padding: 19px;
            height: 100%;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .summary-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .summary-label {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 3px;
        }

        .summary-number {
            font-size: 23px;
            font-weight: 700;
            color: #1f2937;
        }

        .vitals-card {
            background: #ffffff;
            border: 1px solid #e9edf3;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .vitals-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid #edf0f4;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

            .vitals-card-header h5 {
                margin: 0;
                font-weight: 700;
                color: #1f2937;
            }

            .vitals-card-header p {
                margin: 4px 0 0;
                color: #6b7280;
                font-size: 13px;
            }

        .vitals-table {
            margin-bottom: 0;
        }

            .vitals-table thead th {
                background: #f8fafc;
                color: #64748b;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .04em;
                padding: 15px 17px;
                border-bottom: 1px solid #e5e7eb;
                white-space: nowrap;
            }

            .vitals-table tbody td {
                padding: 16px 17px;
                border-bottom: 1px solid #f0f2f5;
                vertical-align: middle;
                color: #374151;
            }

            .vitals-table tbody tr:last-child td {
                border-bottom: none;
            }

            .vitals-table tbody tr {
                transition: background .2s ease;
            }

                .vitals-table tbody tr:hover {
                    background: #f8fafc;
                }

        .nurse-info {
            display: flex;
            align-items: center;
            gap: 9px;
            font-weight: 600;
            color: #374151;
        }

        .nurse-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: #f1f5f9;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .patient-name {
            font-weight: 600;
            color: #1f2937;
        }

        .vital-value {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .temperature {
            background: #fff1f2;
            color: #dc2626;
        }

        .pulse {
            background: #fdf2f8;
            color: #be185d;
        }

        .blood-pressure {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .respiration {
            background: #ecfeff;
            color: #0e7490;
        }

        .recorded-time {
            color: #64748b;
            font-size: 13px;
            white-space: nowrap;
        }

            .recorded-time i {
                margin-right: 5px;
            }

        .latest-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #ecfdf3;
            color: #15803d;
            padding: 7px 11px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .empty-state {
            padding: 70px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 72px;
            height: 72px;
            border-radius: 18px;
            background: #f1f5f9;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 30px;
        }

        .empty-state h4 {
            font-weight: 700;
            color: #374151;
        }

        .empty-state p {
            color: #6b7280;
            margin-bottom: 0;
        }

        @@media (max-width: 991px) {

            .main {
                margin-left: 0;
                padding: 20px;
            }

            .vitals-table {
                min-width: 950px;
            }

            .page-header {
                padding: 20px;
            }
        }

        @@media (max-width: 576px) {

            .main {
                padding: 15px;
            }

            .page-header {
                padding: 18px;
            }

                .page-header .d-flex {
                    align-items: flex-start !important;
                }

            .header-icon {
                width: 45px;
                height: 45px;
                font-size: 20px;
            }

            .page-header h2 {
                font-size: 20px;
            }

            .page-header p {
                font-size: 13px;
            }

            .back-button {
                padding: 7px 10px;
                font-size: 13px;
            }

            .vitals-card-header {
                padding: 17px;
            }

            .summary-card {
                padding: 16px;
            }
        }

    </style>

</head>

<body>

    <div class="main">
        <div class="page-header">

            <div class="d-flex justify-content-between align-items-center gap-3">

                <div class="d-flex align-items-center">

                    <div class="header-icon me-3">

                        <i class="bi bi-heart-pulse-fill"></i>

                    </div>

                    <div>

                        <h2>Patient Vital Signs</h2>

                        <p>
                            Review vital sign history and monitor the patient's condition.
                        </p>

                    </div>

                </div>

                <a asp-action="NurseSisterDashBoard"
                   class="btn btn-outline-secondary back-button">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </a>

            </div>

        </div>


        <div class="row g-3 mb-4">
            <div class="col-md-4">

                <div class="summary-card">

                    <div class="d-flex align-items-center">

                        <div class="summary-icon bg-primary bg-opacity-10 text-primary me-3">

                            <i class="bi bi-person-heart"></i>

                        </div>

                        <div>

                            <div class="summary-label">
                                Patient
                            </div>

                            <div class="summary-number"
                                 style="font-size:18px;">

                                @patientName

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="summary-card">

                    <div class="d-flex align-items-center">

                        <div class="summary-icon bg-info bg-opacity-10 text-info me-3">

                            <i class="bi bi-clipboard2-pulse"></i>

                        </div>

                        <div>

                            <div class="summary-label">
                                Total Records
                            </div>

                            <div class="summary-number">
                                @vitalSigns.Count
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="summary-card">

                    <div class="d-flex align-items-center">

                        <div class="summary-icon bg-success bg-opacity-10 text-success me-3">

                            <i class="bi bi-clock-history"></i>

                        </div>

                        <div>

                            <div class="summary-label">
                                Latest Recording
                            </div>

                            <div class="summary-number"
                                 style="font-size:16px;">

                                @if (latestRecord != null)
                                {
                                    @latestRecord.RecordedAt.ToString("dd MMM yyyy HH:mm")
                                }
                                else
                                {
                                    <span>No records</span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="vitals-card">

            <div class="vitals-card-header">

                <div>

                    <h5>

                        <i class="bi bi-heart-pulse me-2 text-primary"></i>

                        Vital Signs Records

                    </h5>

                    <p>
                        Historical observations recorded by nursing staff.
                    </p>

                </div>

                @if (vitalSigns.Any())
                {
                    <span class="latest-badge">

                        <i class="bi bi-check-circle-fill"></i>

                        Records Available

                    </span>
                }

            </div>


            @if (!vitalSigns.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-heart-pulse"></i>

                    </div>

                    <h4>No Vital Sign Records</h4>

                    <p>
                        There are currently no vital sign records available for this patient.
                    </p>

                </div>

            }
            else
            {
                <div class="table-responsive">

                    <table class="table vitals-table">

                        <thead>

                            <tr>

                                <th>
                                    <i class="bi bi-person-badge me-1"></i>
                                    Recorded By
                                </th>

                                <th>
                                    <i class="bi bi-person me-1"></i>
                                    Patient
                                </th>

                                <th>
                                    <i class="bi bi-thermometer-half me-1"></i>
                                    Temperature
                                </th>

                                <th>
                                    <i class="bi bi-heart-pulse me-1"></i>
                                    Pulse
                                </th>

                                <th>
                                    <i class="bi bi-heart me-1"></i>
                                    Blood Pressure
                                </th>

                                <th>
                                    <i class="bi bi-lungs me-1"></i>
                                    Respiration
                                </th>

                                <th>
                                    <i class="bi bi-clock me-1"></i>
                                    Recorded
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var v in vitalSigns.OrderByDescending(v => v.RecordedAt))
                            {

                                <tr>

                                    <td>

                                        <div class="nurse-info">

                                            <div class="nurse-icon">

                                                <i class="bi bi-person-badge"></i>

                                            </div>

                                            <span>

                                                @(v.Nurse != null ? $"{v.Nurse.FirstName} {v.Nurse.LastName}" : "Unknown") 
                                            </span>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="patient-name">

                                            @v.Patient.FirstName @v.Patient.LastName

                                        </span>

                                    </td>


                                    <td>

                                        <span class="vital-value temperature">

                                            <i class="bi bi-thermometer-half"></i>

                                            @v.BodyTemperature °C

                                        </span>

                                    </td>


                                    <td>

                                        <span class="vital-value pulse">

                                            <i class="bi bi-heart-pulse"></i>

                                            @v.PulseRate bpm

                                        </span>

                                    </td>


                                    <td>

                                        <span class="vital-value blood-pressure">

                                            <i class="bi bi-heart"></i>

                                            @v.BloodPressure

                                        </span>

                                    </td>


                                    <td>

                                        <span class="vital-value respiration">

                                            <i class="bi bi-lungs"></i>

                                            @v.RespiratoryRate /min

                                        </span>

                                    </td>

                                    <td>

                                        <span class="recorded-time">

                                            <i class="bi bi-clock"></i>

                                            @v.RecordedAt.ToString("dd MMM yyyy HH:mm")

                                        </span>

                                    </td>

                                </tr>

                           }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>