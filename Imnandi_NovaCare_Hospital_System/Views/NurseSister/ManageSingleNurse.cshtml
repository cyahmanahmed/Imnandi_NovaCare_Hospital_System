@model Nurse

@{
    ViewData["Title"] = "Manage Nurse";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">

    <h2>
        <i class="bi bi-person-badge-fill me-2"></i>
        Manage Nurse
    </h2>

    <a asp-action="ManageNurses"
       class="btn btn-outline-primary rounded-pill px-4">

        <i class="bi bi-arrow-left"></i>
        Back

    </a>

</div>


<div class="row">

    <div class="col-lg-4 mb-4">

        <div class="profile-card">

            <div class="profile-top">

                <div class="avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <h4 class="mt-3">
                    @Model.FirstName @Model.LastName
                </h4>

                <p class="mb-0">
                    Registered Nurse
                </p>

            </div>

            <div class="p-4">
                <p>
                    <strong>Assigned Patients:</strong>
                    @Model.Patients.Count(p => !p.IsDischarged)
                </p>

                <hr />

                <h6 class="section-title">
                    Assigned Patients
                </h6>

                @if (Model.Patients.Any(p => !p.IsDischarged))
                {
                    @foreach (var patient in Model.Patients.Where(p => !p.IsDischarged))
                    {
                        <span class="patient-badge">
                            <i class="bi bi-person-heart me-1"></i>
                            @patient.FirstName @patient.LastName
                        </span>
                    }
                }
                else
                {
                    <p class="text-muted">
                        No assigned patients.
                    </p>
                }


                <div class="mt-3">

                    <a asp-action="ViewNurseMedicationHistory"
                       asp-route-nurseId="@Model.NurseId"
                       class="btn btn-outline-primary w-100">

                        <i class="bi bi-capsule-pill me-2"></i>

                        View Medication History

                    </a>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-8">

        <div class="card section-card mb-4">

            <div class="card-body">

                <h5 class="section-title">
                    <i class="bi bi-journal-check me-2"></i>
                    Add Performance Note
                </h5>

                <form asp-action="AddPerformanceNote"
                      asp-route-nurseId="@Model.NurseId"
                      method="post">

                    <input type="hidden"
                           name="nurseId"
                           value="@Model.NurseId" />

                    <textarea class="form-control mb-3"
                              rows="4"
                              name="note"
                              required
                              placeholder="Enter performance feedback..."></textarea>

                    <button class="btn btn-success btn-action">
                        <i class="bi bi-check-circle"></i>
                        Save Note
                    </button>

                </form>

            </div>

        </div>

        <div class="card section-card mb-4">

            <div class="card-body">

                <h5 class="section-title">
                    <i class="bi bi-clock-history me-2"></i>
                    Performance History
                </h5>

                @if (Model.PerformanceNotes.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>
                                    <th width="180">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Date
                                    </th>

                                    <th>
                                        <i class="bi bi-journal-text me-1"></i>
                                        Performance Note
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var note in Model.PerformanceNotes)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @note.CreatedDate.ToString("dd MMM yyyy")
                                            </strong>
                                            <br />
                                            <small class="text-muted">
                                                @note.CreatedDate.ToString("HH:mm")
                                            </small>
                                        </td>

                                        <td>
                                            @note.Note
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="text-center py-4">

                        <i class="bi bi-journal-x text-muted"
                           style="font-size:2.5rem;"></i>

                        <h6 class="mt-3 text-muted">
                            No Performance Notes
                        </h6>

                        <p class="text-muted mb-0">
                            Performance notes recorded by the Nurse Sister will appear here.
                        </p>

                    </div>
                }

            </div>

        </div>

        <div class="card section-card mb-4">

            <div class="card-body">

                <h5 class="section-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Report Incident
                </h5>

                <form asp-action="ReportIncident"
                      asp-route-nurseId="@Model.NurseId"
                      method="post">

                    <input type="hidden"
                           name="nurseId"
                           value="@Model.NurseId" />

                    <textarea class="form-control mb-3"
                              rows="4"
                              name="description"
                              required
                              placeholder="Describe the incident..."></textarea>

                    <button class="btn btn-warning btn-action text-white">
                        <i class="bi bi-flag-fill"></i>
                        Report Incident
                    </button>

                </form>

            </div>

        </div>

        <div class="card section-card mb-4">

            <div class="card-body">

                <h5 class="section-title">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    Incident History
                </h5>

                @if (Model.Incidents.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th width="170">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Date
                                    </th>

                                    <th>
                                        <i class="bi bi-file-earmark-text me-1"></i>
                                        Incident
                                    </th>

                                    <th width="150">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Status
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var incident in Model.Incidents)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @incident.IncidentDate.ToString("dd MMM yyyy")
                                            </strong>
                                            <br />
                                            <small class="text-muted">
                                                @incident.IncidentDate.ToString("HH:mm")
                                            </small>
                                        </td>

                                        <td>
                                            @incident.Description
                                        </td>

                                        <td>

                                            @if (incident.IsResolved)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                    Resolved
                                                </span>

                                                @if (incident.ResolvedDate.HasValue)
                                                {
                                                    <br />

                                                    <small class="text-muted">
                                                        @incident.ResolvedDate.Value.ToString("dd MMM yyyy")
                                                    </small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-hourglass-split me-1"></i>
                                                    Pending
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="text-center py-4">

                        <i class="bi bi-shield-exclamation text-muted"
                           style="font-size:2.5rem;"></i>

                        <h6 class="mt-3 text-muted">
                            No Incidents Reported
                        </h6>

                        <p class="text-muted mb-0">
                            Reported incidents for this nurse will appear here.
                        </p>

                    </div>
                }

            </div>

        </div>

        <div class="card section-card mb-4">

            <div class="card-body">

                <h5 class="section-title">
                    <i class="bi bi-bell-fill me-2"></i>
                    Send Alert
                </h5>

                <form asp-action="SendAlert"
                      asp-route-nurseId="@Model.NurseId"
                      method="post">

                    <input type="hidden"
                           name="nurseId"
                           value="@Model.NurseId" />

                    <input class="form-control mb-3"
                           name="subject"
                           placeholder="Alert Subject"
                           required />

                    <textarea class="form-control mb-3"
                              rows="4"
                              name="message"
                              placeholder="Write the alert..."
                              required></textarea>

                    <button class="btn btn-primary btn-action">
                        <i class="bi bi-send-fill"></i>
                        Send Alert
                    </button>

                </form>

            </div>

        </div>

        <div class="card section-card mb-4">

            <div class="card-body">

                <h5 class="section-title">
                    <i class="bi bi-bell-fill me-2"></i>
                    Alert History
                </h5>

                @if (Model.Alerts.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th width="170">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Sent
                                    </th>

                                    <th width="200">
                                        <i class="bi bi-bookmark-fill me-1"></i>
                                        Subject
                                    </th>

                                    <th>
                                        <i class="bi bi-chat-left-text me-1"></i>
                                        Message
                                    </th>

                                    <th width="160">
                                        <i class="bi bi-envelope-check me-1"></i>
                                        Status
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var alert in Model.Alerts)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @alert.SentAt.ToString("dd MMM yyyy")
                                            </strong>
                                            <br />
                                            <small class="text-muted">
                                                @alert.SentAt.ToString("HH:mm")
                                            </small>
                                        </td>

                                        <td>
                                            <strong>@alert.Subject</strong>
                                        </td>

                                        <td>
                                            @alert.Message
                                        </td>

                                        <td>

                                            @if (alert.IsRead)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                    Read
                                                </span>

                                                @if (alert.ReadAt.HasValue)
                                                {
                                                    <br />

                                                    <small class="text-muted">
                                                        @alert.ReadAt.Value.ToString("dd MMM yyyy HH:mm")
                                                    </small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-envelope me-1"></i>
                                                    Unread
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="text-center py-4">

                        <i class="bi bi-bell-slash text-muted"
                           style="font-size:2.5rem;"></i>

                        <h6 class="mt-3 text-muted">
                            No Alerts Sent
                        </h6>

                        <p class="text-muted mb-0">
                            Alerts sent to this nurse will appear here, including whether they have been read.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>