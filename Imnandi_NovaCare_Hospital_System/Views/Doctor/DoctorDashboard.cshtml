@using Imnandi_NovaCare_Hospital_System.Models
@model DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            overflow: auto;
        }

        .doctor-sidebar {
            background-color: #2c3e50;
            width: 250px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 1rem;
            color: white;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .doctor-sidebar a {
            display: block;
            padding: 0.9rem 1.25rem;
            color: white;
            text-decoration: none;
            font-size: 0.95rem;
        }

        .doctor-sidebar a:hover {
            background-color: #34495e;
        }

        .doctor-sidebar .section-title {
            padding: 0.75rem 1.25rem;
            text-transform: uppercase;
            font-size: 0.8rem;
            color: #adb5bd;
        }

        .doctor-dashboard-content {
            margin-left: 250px;
            padding: 2rem;
            min-height: 100vh;
        }

        .card {
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

        .stats-card {
            transition: transform 0.2s ease-in-out;
        }

        .stats-card:hover {
            transform: translateY(-4px);
        }

        .stats-card h2 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .stats-card p {
            margin: 0;
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .search-box input {
            height: 45px;
            border-radius: 6px;
        }

        .btn-view {
            background-color: #0d6efd;
            color: white;
            border-radius: 6px;
            padding: 4px 12px;
        }

        .btn-view:hover {
            background-color: #0a58ca;
        }

        .table th {
            background-color: #e9ecef;
        }

        .fw-bold {
            font-weight: 600 !important;
        }
    </style>
</head>

<body>
    <div class="doctor-sidebar">
        <h3 class="text-center mb-4 fw-bold">Doctor Panel</h3>
        <a asp-controller="Doctor" asp-action="Schedule"><i class="bi bi-calendar-event me-2"></i> Schedule</a>
        <a asp-controller="Doctor" asp-action="VisitHistory"> <i class="bi bi-clock-history me-2"></i> Visit History</a>
        <a asp-controller="Doctor" asp-action="RecentPrescription"><i class="bi bi-capsule me-2"></i>Recent Prescriptions</a>
        <a asp-controller="Doctor" asp-action="ViewAlerts"><i class="bi bi-calendar-event me-2"></i> View Alerts</a>
        
        <h6 class="section-title">Settings</h6>
        <a asp-controller="Doctor" asp-action="Profile"><i class="bi bi-gear me-2"></i> Profile</a>
        <a href="/Identity/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i> Log Out</a>
    </div>

    <div class="doctor-dashboard-content">
        <h1 class="mb-4 fw-bold">Welcome, Dr. @Model.FirstName @Model.LastName</h1>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card p-3 text-center bg-primary text-white stats-card">
                    <h2>@Model.PatientCount</h2>
                    <p>Active Patients</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center bg-success text-white stats-card">
                    <h2>@Model.UpcomingVisitCount</h2>
                    <p>Upcoming Visits</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center bg-info text-dark stats-card">
                    <h2>@Model.RecentPrescriptionCount</h2>
                    <p>Recent Prescriptions</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center bg-warning text-dark stats-card">
                    <h2>@Model.PendingDischargeCount</h2>
                    <p>Pending Discharges</p>
                </div>
            </div>
        </div>

        <div class="card p-4 mb-4">

            <div class="d-flex align-items-center mb-3">
                <div class="me-3">
                    <i class="bi bi-person-badge fs-2 text-primary"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">
                    </h5>

                    <span class="text-muted">
                        @Model.Department Department
                    </span>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4">
                    <strong>Name</strong>
                    <p class="text-muted mb-0">
                        @Model.FirstName @Model.LastName
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Job Title</strong>
                    <p class="text-muted mb-0">
                        @Model.JobTitle
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Email</strong>
                    <p class="text-muted mb-0">
                        @Model.Email
                    </p>
                </div>

            </div>

        </div>

        <form method="get" class="search-box mb-4">
            <div class="input-group">
                <input name="search" value="@(ViewData["Search"] ?? "")" type="text"
                       placeholder="Search by Name or ID Number" class="form-control" />
                <button class="btn btn-primary">Search</button>
                <a href="@Url.Action("DoctorDashboard", "Doctor")" class="btn btn-secondary">Clear</a>
            </div>
        </form>

        <div class="card border-0 shadow-sm p-4 mb-4"
             style="border-radius: 16px;">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h4 class="mb-1 fw-bold text-dark">
                        <i class="bi bi-people-fill text-primary me-2"></i>
                        Your Patients
                    </h4>

                    <p class="text-muted mb-0 small">
                        Patients currently assigned to you.
                    </p>
                </div>

                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    @Model.Patients.Count Patient(s)
                </span>

            </div>

            @if (Model.Patients.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="text-muted small text-uppercase">
                                    First Name
                                </th>

                                <th class="text-muted small text-uppercase">
                                    Last Name
                                </th>

                                <th class="text-muted small text-uppercase">
                                    Status
                                </th>

                                <th class="text-muted small text-uppercase text-end">
                                    Action
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var p in Model.Patients)
                            {
                                <tr>

                                    <td>
                                        <div class="d-flex align-items-center">

                                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3"
                                                 style="width: 40px; height: 40px; font-weight: 700;">

                                                @(p.FirstName?.FirstOrDefault() ?? 'P')

                                            </div>

                                            <span class="fw-semibold text-dark">
                                                @p.FirstName
                                            </span>

                                        </div>
                                    </td>

                                    <td class="fw-semibold text-dark">
                                        @p.LastName
                                    </td>

                                    <td>

                                        @if (!p.IsDischarged &&
                                                                        !p.IsDeleted &&
                                                                        !p.DischargeInstructions.Any())
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Admitted

                                            </span>
                                        }
                                        else if (!p.IsDischarged &&
                                        p.DischargeInstructions.Any())
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2">

                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                Pending Discharge

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Discharged

                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Doctor"
                                           asp-action="PatientsFolder"
                                           asp-route-id="@p.Id"
                                           class="btn btn-outline-primary btn-sm px-3"
                                           style="border-radius: 8px;">

                                            <i class="bi bi-folder2-open me-1"></i>
                                            View Folder

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width: 60px; height: 60px;">

                        <i class="bi bi-people text-muted fs-4"></i>

                    </div>

                    <h6 class="fw-bold text-dark">
                        No Patients Assigned
                    </h6>

                    <p class="text-muted small mb-0">
                        You currently have no patients assigned to you.
                    </p>

                </div>
            }

        </div>

        <div class="card p-3 mb-4">
            <h4 class="mb-3 fw-bold">Pending Discharge Recommendations</h4>
            @if (Model.PendingDischarges.Any())
            {
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Id Number</th>
                            <th>Name</th>
                            <th>IssuedDate</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pd in Model.PendingDischarges)
                        {
                            <tr>
                                <td>@pd.Patient.IdNumber</td>
                                <td>@pd.Patient.FirstName @pd.Patient.LastName</td>
                                <td>@pd.IssuedDate</td>
                                <td>@pd.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center py-4">No pending discharges to review.</p>
            }
        </div>
    </div>
</body>
</html>
