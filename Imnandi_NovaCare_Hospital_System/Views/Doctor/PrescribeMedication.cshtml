@model Prescription
@using Imnandi_NovaCare_Hospital_System.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Prescribe Medication";
    var patient = ViewBag.Patient as Patient;
    var medications = ViewBag.Medications as List<SelectListItem>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Ward Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .container-fluid {
            max-width: 900px;
            margin: 2rem auto;
            padding: 2rem;
        }

        .card {
            border-radius: 0.75rem;
            box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,.1);
            border: none;
            margin-bottom: 1.5rem;
        }

        .card-header {
            background-color: #e9ecef;
            border-bottom: 1px solid #dee2e6;
            font-weight: 600;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-label {
            font-weight: 500;
            color: #212529;
        }

        .form-control,
        .form-select,
        textarea {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        .btn-success {
            background-color: #28a745;
            border-color: #28a745;
        }

        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
        }

        .alert {
            border-radius: 0.5rem;
        }

        .patient-info {
            background-color: #f8f9fa;
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .back-btn {
            text-decoration: none;
            color: #0d6efd;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            padding: 0.35rem 1rem;
            border-radius: 80px;
            background-color: #f8f9fa;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075);
            margin-bottom: 1rem;
        }

            .back-btn i {
                margin-right: 0.5rem;
            }
    </style>
</head>

<body>

    <div class="d-flex align-items-center bg-light border border-primary rounded-5 shadow-sm px-4 py-2 mb-4">
        <i class="bi bi-house-door-fill me-3 text-primary fs-5"></i>

        <a asp-action="DoctorDashboard"
           asp-controller="Doctor"
           class="text-decoration-none text-primary fw-semibold fs-6 btn-sm px-3 d-flex align-items-center shadow-sm"
           style="border-radius: 80px;">
            Back to Dashboard
        </a>
    </div>

    <div class="container-fluid">

        @if (patient != null)
        {
            <div class="patient-info">

                <h5>Patient Information</h5>

                <hr />

                <p>
                    <strong>Name:</strong>
                    @patient.FirstName @patient.LastName
                </p>

                <p>
                    <strong>Patient ID number:</strong>
                    @patient.IdNumber
                </p>

                <p>
                    <strong>Admitted On:</strong>
                    @patient.DateAdmitted.ToShortDateString()
                </p>

                <p>
                    <strong>Assigned Doctor:</strong>
                    @(patient.Doctor?.Employee != null
                                    ? patient.Doctor.Employee.FirstName + " " + patient.Doctor.Employee.LastName
                                    : "N/A")
            </p>

                <p>
                    <strong>Allergies:</strong>
                    @string.Join(", ", patient.Allergies.Select(a => a.Allergen))
                </p>

            </div>
                }

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <i class="bi bi-capsule"></i>
                Prescribe Medication
            </div>

            <div class="card-body">

                <form asp-action="PrescribeMedication" method="post">

                    <input type="hidden" asp-for="PatientId" />
                    <input type="hidden" asp-for="DoctorId" />

                    <div class="mb-3">

                        <label asp-for="MedicationId" class="form-label">
                            Medication
                        </label>

                        <select asp-for="MedicationId"
                                class="form-select"
                                asp-items="medications"
                                required>

                            <option value="">-- Select Medication --</option>

                        </select>

                        <span asp-validation-for="MedicationId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Quantity" class="form-label">
                            Quantity
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               class="form-control"
                               min="1"
                               value="@(Model.Quantity > 0 ? Model.Quantity : 1)"
                               placeholder="Enter quantity"
                               required />

                        <small class="text-muted">
                            Enter the number of units to provide to the patient.
                            For example, enter 3 for three tablets.
                        </small>

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DosageInstructions" class="form-label">
                            Dosage Instructions
                        </label>

                        <textarea asp-for="DosageInstructions"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter dosage instructions for the patient..."
                                  required></textarea>

                        <span asp-validation-for="DosageInstructions"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Level" class="form-label">
                            Medication Level
                        </label>

                        <input type="number"
                               class="form-control"
                               asp-for="Level" />

                        <span asp-validation-for="Level"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle"></i>
                            Prescribe

                        </button>

                        @if (patient != null)
                        {
                            <a asp-action="PatientsFolder"
                               asp-controller="Doctor"
                               asp-route-id="@patient.Id"
                               class="btn btn-secondary">

                                Cancel

                            </a>
                        }

                    </div>

                </form>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>