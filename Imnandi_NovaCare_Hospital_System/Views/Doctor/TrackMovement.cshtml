@model PatientFullHistoryViewModel

@{
    ViewData["Title"] = "Track Patient Movement";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="d-flex justify-content-between mb-3">
        <h3>Patient Movement & Treatment Tracker</h3>
        <div>
            <a asp-controller="Doctor" asp-action="SendMoveRequest" asp-route-patientId="@Model.PatientId" class="btn btn-warning me-2">
                <i class="bi bi-arrow-repeat"></i> Send Move Request
            </a>
            <button class="btn btn-success">
                <i class="bi bi-file-earmark-text"></i> Generate Report
            </button>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Patient Info</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4"><strong>Name:</strong> @Model.FullName</div>
                <div class="col-md-4"><strong>ID Number:</strong> @Model.IdNumber</div>
                <div class="col-md-4"><strong>Current Room:</strong> @Model.CurrentRoom</div>
                <div class="col-md-4"><strong>Current Bed:</strong> @Model.CurrentBed</div>
                <div class="col-md-4"><strong>Date Admitted:</strong> @(Model.DateAdmitted?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                <div class="col-md-4"><strong>Date Discharged:</strong> @(Model.DateDischarged?.ToString("dd/MM/yyyy") ?? "N/A")</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Movement History</h5>
        </div>
        <div class="card-body">
            @if (Model.Movements.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Movement Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Ward Admin</th>
                            <th>Return Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Movements)
                        {
                            <tr>
                                <td>@m.MovementDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@m.MovementType</td>
                                <td>
                                    @(m.FromBed?.BedNumber ?? "N/A")
                                    (@(m.FromRoom?.RoomNumber ?? "N/A"))
                                </td>
                                <td>
                                    @(m.ToBed?.BedNumber ?? "N/A")
                                    (@(m.ToRoom?.RoomNumber ?? "N/A"))
                                </td>
                                <td>@(m.WardAdmin?.Employee?.FirstName) @(m.WardAdmin?.Employee?.LastName)</td>
                                <td>@(m.ReturnTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No movement history found for this patient.</p>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Treatment History</h5>
        </div>
        <div class="card-body">
            @if (Model.Treatments.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Doctor</th>
                            <th>Treatment Type</th>
                            <th>Description</th>
                            <th>Past Treatment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Treatments)
                        {
                            <tr>
                                <td>@t.TreatmentDate.ToString("dd/MM/yyyy")</td>
                                <td>@t.Doctor?.Employee?.FirstName @t.Doctor?.Employee?.LastName</td>
                                <td>@t.TreatmentType</td>
                                <td>@t.Description</td>
                                <td>@t.PastTreatment</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No treatments found for this patient.</p>
            }
        </div>
    </div>
</div>
