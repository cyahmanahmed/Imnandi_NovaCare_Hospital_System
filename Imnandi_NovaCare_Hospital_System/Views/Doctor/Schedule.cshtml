@using Imnandi_NovaCare_Hospital_System.Models
@model List<Schedule>

@{
    ViewData["Title"] = "My Schedule";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Ward Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f5f7fa;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .page-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px;
        }

        .page-header {
            background: #ffffff;
            border-radius: 16px;
            padding: 24px 28px;
            margin-bottom: 20px;
            border: 1px solid #e8ebf0;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .page-title {
            font-size: 26px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #6b7280;
            margin: 0;
            font-size: 14px;
        }

        .dashboard-bar {
            background-color: #ffffff;
            border: 1px solid #cfe2ff;
            border-radius: 50px;
            padding: 10px 18px;
            margin-bottom: 20px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
            display: inline-flex;
            align-items: center;
        }

            .dashboard-bar a {
                text-decoration: none;
                color: #0d6efd;
                font-weight: 600;
            }

        .filter-card {
            background: #ffffff;
            border: 1px solid #e8ebf0;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 20px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .filter-title {
            font-size: 16px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 18px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }

        .form-control {
            height: 44px;
            border-radius: 9px;
            border: 1px solid #d9dee7;
        }

            .form-control:focus {
                border-color: #86b7fe;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
            }

        .btn-filter {
            height: 44px;
            border-radius: 9px;
            font-weight: 600;
            padding: 0 18px;
        }

        .schedule-card {
            background: #ffffff;
            border: 1px solid #e8ebf0;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .schedule-card-header {
            padding: 20px 22px;
            border-bottom: 1px solid #edf0f4;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .schedule-title {
            font-size: 18px;
            font-weight: 700;
            color: #1f2937;
            margin: 0;
        }

        .schedule-subtitle {
            color: #6b7280;
            font-size: 13px;
            margin: 4px 0 0;
        }

        .schedule-count {
            background: #f1f5f9;
            color: #475569;
            border-radius: 50px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 700;
        }

        .table-container {
            overflow-x: auto;
        }

        .schedule-table {
            width: 100%;
            margin: 0;
            border-collapse: collapse;
        }

            .schedule-table thead th {
                background-color: #f8fafc;
                color: #64748b;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .04em;
                font-weight: 700;
                padding: 14px 18px;
                border-bottom: 1px solid #e5e7eb;
                white-space: nowrap;
            }

            .schedule-table tbody td {
                padding: 16px 18px;
                border-bottom: 1px solid #f0f2f5;
                color: #374151;
                font-size: 14px;
                vertical-align: middle;
            }

            .schedule-table tbody tr:last-child td {
                border-bottom: none;
            }

            .schedule-table tbody tr:hover {
                background-color: #fafbfc;
            }

        .patient-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #e9f2ff;
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            margin-right: 12px;
        }

        .patient-name {
            font-weight: 700;
            color: #1f2937;
        }

        .patient-id {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .date-main {
            font-weight: 700;
            color: #1f2937;
        }

        .date-time {
            font-size: 12px;
            color: #64748b;
            margin-top: 2px;
        }

        .visit-badge {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 50px;
            background-color: #eff6ff;
            color: #2563eb;
            font-size: 11px;
            font-weight: 700;
        }

        .location-text {
            color: #475569;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 11px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 700;
        }

        .status-completed {
            background-color: #ecfdf3;
            color: #15803d;
        }

        .status-overdue {
            background-color: #fff7ed;
            color: #c2410c;
        }

        .status-scheduled {
            background-color: #eff6ff;
            color: #2563eb;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            width: 65px;
            height: 65px;
            margin: 0 auto 15px;
            border-radius: 50%;
            background-color: #f1f5f9;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        .empty-title {
            font-weight: 700;
            color: #374151;
            margin-bottom: 5px;
        }

        .empty-text {
            color: #94a3b8;
            font-size: 13px;
            margin: 0;
        }

        .report-card {
            background: #ffffff;
            border: 1px solid #e8ebf0;
            border-radius: 16px;
            padding: 22px;
            margin-top: 20px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .report-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 6px;
        }

        .report-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background-color: #ecfdf3;
            color: #198754;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .report-title {
            font-size: 17px;
            font-weight: 700;
            color: #1f2937;
            margin: 0;
        }

        .report-description {
            color: #6b7280;
            font-size: 13px;
            margin: 0 0 18px 54px;
        }

        .report-form {
            margin-top: 10px;
        }

        .btn-report {
            height: 44px;
            border-radius: 9px;
            font-weight: 600;
            padding: 0 18px;
        }
    </style>
</head>

<body>

    <div class="page-container">

        <div class="page-header">

            <div class="d-flex justify-content-between align-items-start gap-3">

                <div>
                    <div class="page-title">
                        <i class="bi bi-calendar2-week me-2 text-primary"></i>
                        My Schedule
                    </div>

                    <p class="page-subtitle">
                        View and manage your upcoming patient visits and scheduled appointments.
                    </p>
                </div>

                <div class="header-actions">

                    <a asp-action="DoctorDashboard"
                       asp-controller="Doctor"
                       class="btn btn-outline-primary">

                        <i class="bi bi-house-door-fill me-2"></i>
                        Back to Dashboard

                    </a>

                </div>

            </div>

        </div>

        <div class="filter-card">

            <div class="filter-title">
                <i class="bi bi-funnel me-2 text-primary"></i>
                Filter Schedule
            </div>

            <form method="post">

                @Html.AntiForgeryToken()

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label class="form-label">
                            Start Date
                        </label>

                        <input type="date"
                               name="startDate"
                               class="form-control"
                               value="@ViewBag.StartDate" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            End Date
                        </label>

                        <input type="date"
                               name="endDate"
                               class="form-control"
                               value="@ViewBag.EndDate" />

                    </div>

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-outline-primary btn-filter me-2">

                            <i class="bi bi-funnel me-1"></i>
                            Filter

                        </button>

                        <a asp-action="Schedule"
                           class="btn btn-outline-secondary btn-filter">

                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Reset

                        </a>

                    </div>

                </div>

            </form>

        </div>


        <div class="schedule-card">

            <div class="schedule-card-header">

                <div>

                    <h2 class="schedule-title">

                        <i class="bi bi-calendar-check me-2 text-primary"></i>

                        Upcoming Visits

                    </h2>

                    <p class="schedule-subtitle">
                        Your scheduled patient appointments.
                    </p>

                </div>

                <span class="schedule-count">
                    @Model.Count Schedule(s)
                </span>

            </div>


            @if (Model.Any())
            {
                <div class="table-container">

                    <table class="schedule-table">

                        <thead>

                            <tr>

                                <th>Patient</th>

                                <th>Date & Time</th>

                                <th>Visit Type</th>

                                <th>Location</th>

                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="patient-avatar">

                                                @(item.Patient?.FirstName?.FirstOrDefault() ?? 'P')

                                            </div>

                                            <div>

                                                <div class="patient-name">

                                                    @($"{item.Patient?.FirstName} {item.Patient?.LastName}")

                                                </div>

                                                <div class="patient-id">

                                                    Patient ID: @item.PatientId

                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <div class="date-main">

                                            @item.ScheduledDate.ToString("ddd, MMM dd, yyyy")

                                        </div>

                                        <div class="date-time">

                                            <i class="bi bi-clock me-1"></i>

                                            @item.ScheduledDate.ToString("h:mm tt")

                                        </div>

                                    </td>

                                    <td>

                                        <span class="visit-badge">

                                            <i class="bi bi-clipboard2-pulse me-1"></i>

                                            @item.VisitType

                                        </span>

                                    </td>


                                    <td>

                                        <span class="location-text">

                                            <i class="bi bi-geo-alt me-1 text-muted"></i>

                                            @item.Location

                                        </span>

                                    </td>

                                    <td>

                                        @if (item.IsCompleted)
                                        {
                                            <span class="status-badge status-completed">

                                                <i class="bi bi-check-circle"></i>

                                                Completed

                                            </span>
                                        }
                                        else if (item.ScheduledDate < DateTime.Now)
                                        {
                                            <span class="status-badge status-overdue">

                                                <i class="bi bi-exclamation-triangle"></i>

                                                Overdue

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-scheduled">

                                                <i class="bi bi-calendar-check"></i>

                                                Scheduled

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-calendar-x"></i>

                    </div>

                    <div class="empty-title">

                        No Scheduled Visits

                    </div>

                    <p class="empty-text">

                        @if (ViewBag.StartDate != null || ViewBag.EndDate != null)
                        {
                            <span>
                                No visits were found for the selected date range.
                                Try adjusting your filter.
                            </span>
                        }
                        else
                        {
                            <span>
                                There are currently no scheduled patient visits.
                            </span>
                        }

                    </p>

                </div>
            }

        </div>

        <div class="report-card">

            <div class="report-header">

                <div class="report-icon">

                    <i class="bi bi-file-earmark-bar-graph"></i>

                </div>

                <h3 class="report-title">

                    Schedule Report

                </h3>

            </div>

            <p class="report-description">

                Generate a report of your scheduled visits for a selected month
                to provide to senior management.

            </p>


            <form asp-controller="Reports"
                  asp-action="DoctorScheduleReport"
                  method="get"
                  class="report-form">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">

                        <label for="month"
                               class="form-label">

                            Select Month

                        </label>

                        <input type="month"
                               id="month"
                               name="month"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-outline-success btn-report">

                            <i class="bi bi-file-earmark-pdf-fill me-1"></i>

                            Generate Schedule Report

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>